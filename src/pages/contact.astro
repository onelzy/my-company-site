---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';

const metadata = {
  title: 'Contact',
};

const address = 'Room 501, 5/F, Building C07, Software Park III, Jimei District, Xiamen, Fujian, China';
const phone = '+86 592 6300186';
const email = 'info@owon-iot.com';
const whatsapp = '+86 186 5013 9895';
const wechat = '+86 186 5013 9895';
const mapEmbed =
  'https://www.openstreetmap.org/export/embed.html?bbox=118.028%2C24.586%2C118.088%2C24.626&layer=mapnik&marker=24.606%2C118.058';
---

<Layout metadata={metadata}>
  <HeroText tagline="Contact" title="Let's Connect!" />

  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-start">
      <!-- LEFT: Contact form -->
      <ContactUs
        id="form"
        title="Drop us a message today!"
        subtitle="For quicker answers, explore our FAQs section. If not, our support team is delighted to help you."
        inputs={[
          {
            type: 'text',
            name: 'name',
            label: 'Name',
          },
          {
            type: 'email',
            name: 'email',
            label: 'Email',
          },
        ]}
        textarea={{
          label: 'Message',
        }}
        disclaimer={{
          label:
            'By submitting this contact form, you acknowledge and agree to the collection of your personal information.',
        }}
        description="Our support team typically responds within 24 business hours."
      />

      <!-- RIGHT: Company information -->
      <div>
        <h2 class="text-xl font-semibold text-default dark:text-slate-100 mb-4">Company Information</h2>
        <div class="rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 space-y-5">
          <div class="flex items-start gap-3">
            <span class="text-lg leading-6">📍</span>
            <div>
              <p class="text-sm font-medium text-default dark:text-slate-200">Address</p>
              <p class="text-sm text-muted dark:text-slate-400 mt-0.5">{address}</p>
            </div>
          </div>

          <div class="rounded-lg overflow-hidden border border-gray-200 dark:border-slate-700">
            <iframe title="OWON location map" src={mapEmbed} class="w-full h-56 sm:h-64" loading="lazy"></iframe>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-lg leading-6">📞</span>
            <div>
              <p class="text-sm font-medium text-default dark:text-slate-200">Phone</p>
              <a
                href={`tel:${phone.replace(/[^+\d]/g, '')}`}
                class="text-sm text-muted dark:text-slate-400 hover:text-link dark:hover:text-white transition duration-150 ease-in-out"
              >
                {phone}
              </a>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-lg leading-6">✉️</span>
            <div>
              <p class="text-sm font-medium text-default dark:text-slate-200">Email</p>
              <a
                href={`mailto:${email}`}
                class="text-sm text-muted dark:text-slate-400 hover:text-link dark:hover:text-white transition duration-150 ease-in-out"
              >
                {email}
              </a>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-lg leading-6">💬</span>
            <div>
              <p class="text-sm font-medium text-default dark:text-slate-200">WhatsApp</p>
              <a
                href={`https://wa.me/${whatsapp.replace(/\D/g, '')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-muted dark:text-slate-400 hover:text-link dark:hover:text-white transition duration-150 ease-in-out"
              >
                {whatsapp}
              </a>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-lg leading-6">💚</span>
            <div>
              <p class="text-sm font-medium text-default dark:text-slate-200">WeChat</p>
              <p class="text-sm text-muted dark:text-slate-400 mt-0.5">{wechat}</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-lg leading-6">🕐</span>
            <div>
              <p class="text-sm font-medium text-default dark:text-slate-200">Working Hours</p>
              <p class="text-sm text-muted dark:text-slate-400 mt-0.5">Mon–Fri 9:00–18:00 (GMT+8)</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
