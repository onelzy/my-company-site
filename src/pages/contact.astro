---
/**
 * Contact — single contact page (no global nav).
 * Form + company info card. Pre-fills email from query params.
 */
import Layout from '~/layouts/Layout.astro';
import Logo from '~/components/Logo.astro';
import { Icon } from 'astro-icon/components';
const url = new URL(Astro.request.url);
const prefilledEmail = url.searchParams.get('email') || '';

const metadata = {
  title: 'Contact Us',
  description: 'Get in touch with our team for product pricing, demos, technical support, and custom solutions.',
};
---

<Layout metadata={metadata}>
  <div class="min-h-screen flex flex-col">
    <!-- Minimal header: logo only -->
    <header class="py-5 px-4 sm:px-6 lg:px-8 border-b border-gray-200 dark:border-slate-800">
      <div class="max-w-6xl mx-auto">
        <a href="/" class="inline-flex items-center">
          <Logo />
        </a>
      </div>
    </header>

    <!-- Main content -->
    <main class="flex-1 py-8 sm:py-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h1 class="text-3xl font-bold sm:text-4xl text-default dark:text-slate-100 mb-3">Contact Us</h1>
          <p class="text-lg text-muted dark:text-slate-400 max-w-xl mx-auto">
            Tell us about your project and we'll get back to you within one business day.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16">
          <!-- Left: Company information -->
          <div class="order-2 lg:order-1">
            <h2 class="text-xl font-semibold mb-4 text-default dark:text-slate-200">XIAMEN OWON TECHNOLOGY CO.,LTD.</h2>
            <div
              class="rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 space-y-5"
            >
              <div class="flex items-start gap-3">
                <Icon name="tabler:map-pin" class="w-5 h-5 leading-6" />
                <div>
                  <p class="text-sm font-medium text-default dark:text-slate-200">Address</p>
                  <p class="text-sm text-muted dark:text-slate-400 mt-0.5">
                    Room 501, 5/F, Building C07, Software Park III, Jimei District, Xiamen, Fujian, China
                  </p>
                </div>
              </div>

              <div class="rounded-lg overflow-hidden border border-gray-200 dark:border-slate-700">
                <iframe
                  title="OWON location map"
                  src="https://www.google.com/maps?q=Software%20Park%20III%2C%20Jimei%20District%2C%20Xiamen%2C%20Fujian%2C%20China&z=15&output=embed"
                  class="w-full h-56 sm:h-64"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"></iframe>
              </div>
              <p class="text-xs text-muted dark:text-slate-500">
                <a
                  href="https://www.google.com/maps/search/?api=1&query=Software+Park+III%2C+Jimei+District%2C+Xiamen%2C+China"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-link dark:hover:text-white transition duration-150 ease-in-out"
                >
                  View on Google Maps →
                </a>
              </p>

              <div class="flex items-start gap-3">
                <Icon name="tabler:phone" class="w-5 h-5 leading-6" />
                <div>
                  <p class="text-sm font-medium text-default dark:text-slate-200">Phone / WhatsApp / WeChat</p>
                  <a
                    href="tel:+8618650139895"
                    class="text-sm text-muted dark:text-slate-400 hover:text-link dark:hover:text-white transition duration-150 ease-in-out"
                  >
                    +86 186 5013 9895
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <span class="text-lg leading-6"></span>
                <div>
                  <p class="text-sm font-medium text-default dark:text-slate-200">Email</p>
                  <a
                    href="mailto:info@owon-iot.com"
                    class="text-sm text-muted dark:text-slate-400 hover:text-link dark:hover:text-white transition duration-150 ease-in-out"
                  >
                    info@owon-iot.com
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <Icon name="tabler:clock" class="w-5 h-5 leading-6" />
                <div>
                  <p class="text-sm font-medium text-default dark:text-slate-200">Working Hours</p>
                  <p class="text-sm text-muted dark:text-slate-400 mt-0.5">Mon–Fri 9:00–18:00 (GMT+8)</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Contact Form -->
          <div class="order-1 lg:order-2">
            <h2 class="text-xl font-semibold mb-4 text-default dark:text-slate-200">Send us a message</h2>
            <form id="contactSalesForm" class="space-y-4" method="POST" action="/api/contact">
              <input type="hidden" name="source" value="contact" />
              <input
                type="text"
                name="company_website"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
                class="hidden"
              />
              <div>
                <label for="fullName" class="block text-sm font-medium text-default dark:text-slate-300 mb-1.5">
                  Full Name *
                </label>
                <input
                  type="text"
                  id="fullName"
                  name="fullName"
                  required
                  class="w-full px-3.5 py-2.5 rounded-lg border border-gray-300 dark:border-slate-700
                              bg-white dark:bg-slate-800 text-default dark:text-slate-200 text-sm
                              focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-shadow"
                  placeholder="John Smith"
                />
              </div>

              <div>
                <label for="businessEmail" class="block text-sm font-medium text-default dark:text-slate-300 mb-1.5">
                  Business Email *
                </label>
                <input
                  type="email"
                  id="businessEmail"
                  name="businessEmail"
                  required
                  value={prefilledEmail}
                  class="w-full px-3.5 py-2.5 rounded-lg border border-gray-300 dark:border-slate-700
                              bg-white dark:bg-slate-800 text-default dark:text-slate-200 text-sm
                              focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-shadow"
                  placeholder="you@company.com"
                />
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-default dark:text-slate-300 mb-1.5">
                  Message / Project Details *
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="4"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-gray-300 dark:border-slate-700
                                 bg-white dark:bg-slate-800 text-default dark:text-slate-200 text-sm
                                 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-shadow resize-y"
                  placeholder="Tell us about your project, requirements, timeline..."></textarea>
              </div>

              <button
                type="submit"
                class="w-full py-3 px-6 rounded-lg font-semibold text-sm text-white transition-all
                             bg-[#FF6B00] hover:bg-[#E55D00] active:scale-[0.98]"
              >
                Send Message
              </button>

              <div class="flex items-start gap-2 text-xs text-muted dark:text-slate-500 pt-1">
                <span class="shrink-0 mt-0.5"></span>
                <span>We respect your privacy. Your data will only be used to process your inquiry.</span>
              </div>
            </form>

            <!-- Success message (hidden initially) -->
            <div id="contactSuccess" class="hidden text-center py-8">
              <Icon name="tabler:check" class="w-10 h-10 mb-3" />
              <h3 class="text-lg font-semibold text-default dark:text-slate-100 mb-2">Message sent!</h3>
              <p class="text-sm text-muted dark:text-slate-400">We'll get back to you within one business day.</p>
            </div>
          </div>
        </div>

        <!-- Quick connect buttons -->
        <div class="mt-16 pt-8 border-t border-gray-200 dark:border-slate-800 text-center">
          <p class="text-sm text-muted dark:text-slate-400 mb-4">Or reach us directly:</p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href="https://wa.me/8618650139895"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[#25D366] text-white font-medium text-sm hover:opacity-90 transition-opacity"
            >
              Chat on WhatsApp
            </a>
            <a
              href="mailto:info@owon-iot.com"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[#6264A7] text-white font-medium text-sm hover:opacity-90 transition-opacity"
            >
              Email to info@owon-iot.com
            </a>
          </div>
        </div>
      </div>
    </main>

    <!-- Minimal footer -->
    <footer
      class="py-4 px-4 text-center text-xs text-muted dark:text-slate-500 border-t border-gray-200 dark:border-slate-800"
    >
      © {new Date().getFullYear()} XIAMEN OWON TECHNOLOGY CO.,LTD. All rights reserved.
    </footer>
  </div>
</Layout>

<script is:inline>
  // Show success if redirected back from a no-JS native submit.
  (function () {
    if (new URLSearchParams(window.location.search).get('thanks') === '1') {
      const form = document.getElementById('contactSalesForm');
      const success = document.getElementById('contactSuccess');
      if (form) form.classList.add('hidden');
      if (success) success.classList.remove('hidden');
    }
  })();

  document.getElementById('contactSalesForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button[type="submit"]');

    // Basic validation
    const emailInput = form.querySelector('#businessEmail');
    const email = (emailInput && emailInput.value ? emailInput.value : '').trim();
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      alert('Please enter a valid business email address.');
      return;
    }

    btn.textContent = 'Sending...';
    btn.disabled = true;

    try {
      const body = new FormData(form);
      // Session tracking (entry referrer, duration, pages, UTM)
      const track = typeof window.__leadTrack === 'function' ? window.__leadTrack() : {};
      Object.keys(track).forEach((k) => {
        if (track[k]) body.append(k, String(track[k]));
      });

      const res = await fetch('/api/contact', {
        method: 'POST',
        body,
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error('send failed');
      form.classList.add('hidden');
      document.getElementById('contactSuccess')?.classList.remove('hidden');
    } catch {
      btn.textContent = 'Send Message';
      btn.disabled = false;
      alert(
        'Sorry, something went wrong. Please try again, or email us directly at info@owon-iot.com or chat on WhatsApp.'
      );
    }
  });
</script>
