---
// Case Studies index — summary cards linking to /case-studies/<slug>/ detail pages.
// Content source: 2026 OWON Technology Catalog + AiHome senior care brochure (no fabrication).
import PageLayout from '~/layouts/PageLayout.astro';
import ContactBand from '~/components/common/ContactBand.astro';
import { caseStudies } from '~/data/caseStudies';

// Static page: build-time render → CDN-cached.
export const prerender = true;

const industries = ['All', 'Carbon & Energy', 'HVAC & Heating', 'Hospitality', 'Senior Care', 'Telecom & Utility'];
---

<PageLayout
  metadata={{
    title: 'Case Studies',
    description:
      'Real-world IoT deployments across carbon monitoring, HVAC, hospitality, telecom, and senior care — documented from OWON product catalogs and solution brochures.',
  }}
>
  <section class="py-8 lg:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {/* Breadcrumb */}
      <nav class="mb-4 text-sm text-muted dark:text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-default dark:text-slate-200">Case Studies</span>
      </nav>

      {/* Page heading */}
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-default dark:text-slate-100">Customer Case Studies</h1>
        <p class="text-muted dark:text-slate-400 mt-2 max-w-2xl">
          Real deployments documented from OWON product catalogs and solution brochures.
        </p>
      </div>

      {/* Category Filter */}
      <div class="flex items-center gap-2 flex-wrap mb-8" id="industryFilters">
        <span class="text-xs font-semibold text-gray-700 dark:text-slate-300 uppercase tracking-wider mr-1"
          >Category:</span
        >
        {
          industries.map((ind, i) => (
            <button
              class={`filter-chip px-4 py-2 rounded-full text-sm font-semibold cursor-pointer transition-all duration-150 ${
                i === 0
                  ? 'bg-primary text-primary-foreground border border-primary shadow-sm'
                  : 'text-gray-600 dark:text-slate-400 bg-white dark:bg-slate-800 border-2 border-gray-300 dark:border-slate-600 hover:border-primary dark:hover:border-primary hover:text-primary'
              }`}
              data-category={ind}
            >
              {ind}
            </button>
          ))
        }
      </div>

      {/* Case Study Cards — summary cards linking to detail pages */}
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" id="caseStudyGrid">
        {
          caseStudies.map((cs) => (
            <a
              href={`/case-studies/${cs.slug}/`}
              class="case-study-item group block rounded-xl bg-white dark:bg-slate-800 shadow-md hover:shadow-xl border border-gray-200 dark:border-slate-700 transition-all overflow-hidden"
              data-category={cs.category}
            >
              {/* Blog-style cover image (placeholder until real case photos exist) */}
              <div class="relative aspect-square overflow-hidden bg-gray-100 dark:bg-slate-900">
                <img
                  src={cs.image}
                  alt={cs.title}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <div class="p-4 sm:p-5">
                {/* Header */}
                <div class="flex items-center gap-1.5 mb-2 flex-wrap">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-primary/10 text-primary">
                    {cs.category}
                  </span>
                  <span class="text-[11px] text-muted dark:text-slate-500">{cs.location}</span>
                </div>

                <h3 class="text-sm sm:text-base font-semibold text-default dark:text-slate-100 mb-1 group-hover:text-primary transition-colors leading-snug line-clamp-2">
                  {cs.title}
                </h3>
                <p class="text-[11px] text-muted dark:text-slate-500 mb-2 line-clamp-1">{cs.client}</p>

                {/* Excerpt */}
                <p class="text-xs text-muted dark:text-slate-400 leading-relaxed line-clamp-2">{cs.background}</p>

                {/* Action */}
                <div class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-primary group-hover:underline">
                  Read case study →
                </div>
              </div>
            </a>
          ))
        }
      </div>

      {/* No Results */}
      <div id="noResults" class="hidden text-center py-16">
        <h3 class="text-lg font-semibold text-default dark:text-slate-200 mb-2">
          No case studies in this category yet
        </h3>
        <p class="text-sm text-muted dark:text-slate-400 mb-4">Contact us — you could be the first.</p>
        <a
          href="/contact"
          class="inline-flex items-center px-5 py-2.5 bg-primary text-primary-foreground rounded-lg font-medium hover:opacity-90 transition-opacity text-sm"
        >
          Contact Us →
        </a>
      </div>

      {/* Bottom CTA */}
      <ContactBand />
    </div>
  </section>
</PageLayout>

<script is:inline>
  (function () {
    const filters = document.getElementById('industryFilters');
    if (!filters) return;
    const chips = filters.querySelectorAll('.filter-chip');
    const items = document.querySelectorAll('.case-study-item');
    const noResults = document.getElementById('noResults');

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        chips.forEach(function (c) {
          c.className = c.className.replace(
            /bg-primary text-primary-foreground border border-primary shadow-sm/g,
            'text-gray-600 dark:text-slate-400 bg-white dark:bg-slate-800 border-2 border-gray-300 dark:border-slate-600 hover:border-primary dark:hover:border-primary hover:text-primary'
          );
        });
        this.className =
          'filter-chip px-4 py-2 rounded-full text-sm font-semibold cursor-pointer transition-all duration-150 bg-primary text-primary-foreground border border-primary shadow-sm';

        const category = this.getAttribute('data-category');
        let anyVisible = false;
        items.forEach(function (item) {
          if (category === 'All' || item.getAttribute('data-category') === category) {
            item.style.display = '';
            anyVisible = true;
          } else {
            item.style.display = 'none';
          }
        });
        if (noResults) noResults.style.display = anyVisible ? 'none' : '';
      });
    });
  })();
</script>
