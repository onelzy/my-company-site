---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Us',
};
---

<Layout metadata={metadata}>
  <section class="max-w-7xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-6">XIAMEN OWON TECHNOLOGY CO.,LTD</h1>
    <p class="text-lg text-muted max-w-3xl">
      OWON is a leading B2B IoT manufacturer specializing in smart energy meters,
      thermostats, hotel control systems, and senior care devices. We help businesses
      worldwide reduce energy costs and build smarter environments.
    </p>

    <div class="grid grid-cols-3 gap-8 mt-12">
      <div>
        <h3 class="text-xl font-semibold">60+</h3>
        <p class="text-muted">Countries Served</p>
      </div>
      <div>
        <h3 class="text-xl font-semibold">280+</h3>
        <p class="text-muted">Product Models</p>
      </div>
      <div>
        <h3 class="text-xl font-semibold">100+</h3>
        <p class="text-muted">R&D Engineers</p>
      </div>
    </div>

    <div class="mt-16 grid md:grid-cols-2 gap-8">
      <div>
        <h2 class="text-2xl font-bold mb-4">What We Make</h2>
        <ul class="space-y-3 text-muted">
          <li>🔌 Smart Energy Meters — ZigBee, WiFi, Modbus</li>
          <li>🌡️ Smart Thermostats — Tuya & MQTT HVAC controllers</li>
          <li>🛏️ Hotel Control Systems — Room automation with PMS integration</li>
          <li>❤️ Senior Care — Non-contact sleep monitoring & emergency call</li>
          <li>☁️ EdgeEco IoT Platform — Private cloud device management</li>
          <li>🔧 OEM/ODM — Custom hardware, firmware, branding</li>
        </ul>
      </div>
      <div>
        <h2 class="text-2xl font-bold mb-4">Our Values</h2>
        <div class="space-y-4">
          <div>
            <h3 class="font-semibold">Interoperability First</h3>
            <p class="text-muted text-sm">Works with Tuya, ZigBee2MQTT, Home Assistant — no vendor lock-in.</p>
          </div>
          <div>
            <h3 class="font-semibold">Engineering Excellence</h3>
            <p class="text-muted text-sm">100+ R&D engineers, ISO 9001 certified manufacturing.</p>
          </div>
          <div>
            <h3 class="font-semibold">Global Partnership</h3>
            <p class="text-muted text-sm">Distributors and integrators in 60+ countries with multilingual support.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-16 p-8 bg-gray-50 dark:bg-slate-800 rounded-xl">
      <h2 class="text-2xl font-bold mb-4">Contact Us</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        <div>
          <p class="text-sm text-muted">Email</p>
          <p class="font-medium">info@owon-iot.com</p>
        </div>
        <div>
          <p class="text-sm text-muted">WhatsApp</p>
          <p class="font-medium">+86 186 5013 9895</p>
        </div>
        <div>
          <p class="text-sm text-muted">Headquarters</p>
          <p class="font-medium">Xiamen, Fujian, China</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
