---
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from 'astrowind:config';

const metadata = {
  title: 'About Us',
};

const email = SITE.contact?.email || 'info@owon-iot.com';
---

<Layout metadata={metadata}>
  <!-- ===== Hero Section ===== -->
  <section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white">
    <!-- Background pattern -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 25% 25%, rgba(59,130,246,0.3) 0%, transparent 50%), radial-gradient(circle at 75% 75%, rgba(99,102,241,0.3) 0%, transparent 50%)"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
      <div class="max-w-3xl">
        <p class="text-blue-400 font-semibold text-sm tracking-widest uppercase mb-4">XIAMEN OWON TECHNOLOGY CO.,LTD</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-6 leading-tight">
          Powering the<br/>
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-300">Intelligent Edge</span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-300 max-w-2xl leading-relaxed">
          We design and manufacture IoT devices that connect buildings, monitor energy,
          and care for people — deployed in 60+ countries by distributors and integrators worldwide.
        </p>
        <div class="flex flex-wrap gap-4 mt-8">
          <a href="/contact-sales" class="inline-flex items-center px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-semibold transition-colors shadow-lg shadow-blue-600/25">
            Talk to Sales
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <a href="/products" class="inline-flex items-center px-6 py-3 rounded-lg border border-slate-500 hover:border-white text-slate-200 hover:text-white font-semibold transition-colors">
            Explore Products
          </a>
        </div>
      </div>
    </div>
    <!-- Bottom fade -->
    <div class="absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-white dark:from-slate-950 to-transparent"></div>
  </section>

  <!-- ===== Stats Bar ===== -->
  <section class="relative -mt-16 z-10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg p-6 text-center border border-gray-100 dark:border-slate-700">
          <p class="text-3xl sm:text-4xl font-extrabold text-blue-600">60<span class="text-xl">+</span></p>
          <p class="text-sm text-muted mt-1">Countries Served</p>
        </div>
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg p-6 text-center border border-gray-100 dark:border-slate-700">
          <p class="text-3xl sm:text-4xl font-extrabold text-blue-600">280<span class="text-xl">+</span></p>
          <p class="text-sm text-muted mt-1">Product Models</p>
        </div>
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg p-6 text-center border border-gray-100 dark:border-slate-700">
          <p class="text-3xl sm:text-4xl font-extrabold text-blue-600">100<span class="text-xl">+</span></p>
          <p class="text-sm text-muted mt-1">R&D Engineers</p>
        </div>
        <div class="bg-white dark:bg-slate-800 rounded-xl shadow-lg p-6 text-center border border-gray-100 dark:border-slate-700">
          <p class="text-3xl sm:text-4xl font-extrabold text-blue-600">10<span class="text-xl">+</span></p>
          <p class="text-sm text-muted mt-1">Years of IoT</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Who We Are ===== -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-blue-600 dark:text-blue-400 font-semibold text-sm tracking-widest uppercase mb-3">Who We Are</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-default dark:text-slate-100 mb-6">
            From Xiamen to the world —<br/>IoT hardware built for scale
          </h2>
          <div class="space-y-4 text-muted leading-relaxed">
            <p>
              Founded in Xiamen, China's premier electronics manufacturing hub, OWON Technology
              has grown into a trusted B2B IoT partner for distributors, system integrators, and
              OEM brands across six continents.
            </p>
            <p>
              Our 100+ R&D engineers design every product in-house — from PCB layout and firmware
              to cloud APIs and mobile apps. With ISO 9001 certified manufacturing and rigorous
              QA processes, we deliver reliability at competitive volumes.
            </p>
            <p>
              We believe in <strong class="text-default dark:text-slate-200">open protocols</strong> and
              <strong class="text-default dark:text-slate-200">no vendor lock-in</strong>. Every OWON
              device works with Tuya, ZigBee2MQTT, Home Assistant, and major cloud platforms out of the box.
            </p>
          </div>
        </div>
        <div class="relative">
          <div class="aspect-[4/3] rounded-2xl bg-gradient-to-br from-blue-100 via-indigo-50 to-slate-100 dark:from-slate-800 dark:via-slate-700 dark:to-slate-800 flex items-center justify-center overflow-hidden shadow-xl">
            <div class="text-center p-8">
              <div class="text-6xl mb-4">🏭</div>
              <p class="text-lg font-semibold text-default dark:text-slate-200">ISO 9001 Certified</p>
              <p class="text-sm text-muted mt-1">Xiamen, Fujian, China</p>
            </div>
          </div>
          <!-- Floating badge -->
          <div class="absolute -bottom-4 -left-4 bg-blue-600 text-white rounded-xl px-5 py-3 shadow-lg">
            <p class="text-xs font-medium opacity-80">Trusted by</p>
            <p class="text-lg font-bold">60+ Countries</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Product Lines ===== -->
  <section class="py-20 bg-gray-50 dark:bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <p class="text-blue-600 dark:text-blue-400 font-semibold text-sm tracking-widest uppercase mb-3">What We Build</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-default dark:text-slate-100 mb-4">Complete IoT product ecosystem</h2>
        <p class="text-muted">Hardware, software, and cloud — one integrated stack for energy management and building automation.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="group bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-slate-700 hover:shadow-md hover:border-blue-200 dark:hover:border-blue-800 transition-all">
          <div class="w-12 h-12 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="text-lg font-semibold text-default dark:text-slate-100 mb-2">Smart Energy Meters</h3>
          <p class="text-sm text-muted leading-relaxed">ZigBee 3.0, WiFi, and Modbus RTU meters with Class 1.0 accuracy. Single and three-phase models for residential to industrial use.</p>
        </div>
        <!-- Card 2 -->
        <div class="group bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-slate-700 hover:shadow-md hover:border-blue-200 dark:hover:border-blue-800 transition-all">
          <div class="w-12 h-12 rounded-lg bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-3.3 0-6 2.7-6 6s2.7 6 6 6 6-2.7 6-6-2.7-6-6-6z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v4m0 12v4M4.9 4.9l2.8 2.8m8.5 8.5l2.8 2.8M2 12h4m12 0h4M4.9 19.1l2.8-2.8m8.5-8.5l2.8-2.8"/></svg>
          </div>
          <h3 class="text-lg font-semibold text-default dark:text-slate-100 mb-2">Smart Thermostats</h3>
          <p class="text-sm text-muted leading-relaxed">Tuya & MQTT HVAC controllers with touchscreen interfaces. North American and European models with scheduling and geofencing.</p>
        </div>
        <!-- Card 3 -->
        <div class="group bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-slate-700 hover:shadow-md hover:border-blue-200 dark:hover:border-blue-800 transition-all">
          <div class="w-12 h-12 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
          </div>
          <h3 class="text-lg font-semibold text-default dark:text-slate-100 mb-2">Hotel Control Systems</h3>
          <p class="text-sm text-muted leading-relaxed">ZigBee room automation: thermostats, lighting panels, E-ink door signs. PMS integration with per-room energy analytics.</p>
        </div>
        <!-- Card 4 -->
        <div class="group bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-slate-700 hover:shadow-md hover:border-blue-200 dark:hover:border-blue-800 transition-all">
          <div class="w-12 h-12 rounded-lg bg-rose-100 dark:bg-rose-900/30 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          </div>
          <h3 class="text-lg font-semibold text-default dark:text-slate-100 mb-2">Senior Care Devices</h3>
          <p class="text-sm text-muted leading-relaxed">Non-contact sleep monitors, emergency call buttons, and fall detection. AiJuan nurse dashboard for elderly care facilities.</p>
        </div>
        <!-- Card 5 -->
        <div class="group bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-slate-700 hover:shadow-md hover:border-blue-200 dark:hover:border-blue-800 transition-all">
          <div class="w-12 h-12 rounded-lg bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/></svg>
          </div>
          <h3 class="text-lg font-semibold text-default dark:text-slate-100 mb-2">EdgeEco IoT Platform</h3>
          <p class="text-sm text-muted leading-relaxed">Private cloud device management with MQTT & REST API. Real-time dashboards, multi-tenant support, and automated reporting.</p>
        </div>
        <!-- Card 6 -->
        <div class="group bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-slate-700 hover:shadow-md hover:border-blue-200 dark:hover:border-blue-800 transition-all">
          <div class="w-12 h-12 rounded-lg bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-lg font-semibold text-default dark:text-slate-100 mb-2">OEM / ODM Services</h3>
          <p class="text-sm text-muted leading-relaxed">Custom hardware design, firmware, branding, and packaging. Tailored IoT solutions for distributors and regional markets.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Our Values ===== -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <p class="text-blue-600 dark:text-blue-400 font-semibold text-sm tracking-widest uppercase mb-3">Our DNA</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-default dark:text-slate-100 mb-4">Built on three principles</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-default dark:text-slate-100 mb-3">Open Standards</h3>
          <p class="text-muted leading-relaxed">
            Every device speaks ZigBee 3.0, MQTT, Modbus, or Tuya — no proprietary lock-in.
            Works with Home Assistant, ZigBee2MQTT, and major cloud platforms out of the box.
          </p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-default dark:text-slate-100 mb-3">Quality by Design</h3>
          <p class="text-muted leading-relaxed">
            ISO 9001 manufacturing with 100% product testing. In-house PCB design,
            firmware, and cloud stack ensure end-to-end quality control.
          </p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto rounded-2xl bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-default dark:text-slate-100 mb-3">Global Partnership</h3>
          <p class="text-muted leading-relaxed">
            Multilingual support, fast lead times, and flexible OEM/ODM services.
            60+ country distribution network built on trust and long-term relationships.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Protocols & Ecosystems ===== -->
  <section class="py-20 bg-gray-50 dark:bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <p class="text-blue-600 dark:text-blue-400 font-semibold text-sm tracking-widest uppercase mb-3">Technology</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-default dark:text-slate-100 mb-4">Protocols & ecosystems we support</h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white dark:bg-slate-800 rounded-xl p-6 text-center border border-gray-100 dark:border-slate-700">
          <div class="text-3xl font-extrabold text-blue-600 mb-2">ZigBee 3.0</div>
          <p class="text-sm text-muted">Self-healing mesh • 100m+ range • Low power • 250+ devices per gateway</p>
        </div>
        <div class="bg-white dark:bg-slate-800 rounded-xl p-6 text-center border border-gray-100 dark:border-slate-700">
          <div class="text-3xl font-extrabold text-orange-600 mb-2">Tuya</div>
          <p class="text-sm text-muted">Certified devices • Smart Life app • Global cloud • Consumer-friendly</p>
        </div>
        <div class="bg-white dark:bg-slate-800 rounded-xl p-6 text-center border border-gray-100 dark:border-slate-700">
          <div class="text-3xl font-extrabold text-emerald-600 mb-2">MQTT</div>
          <p class="text-sm text-muted">Real-time streaming • TLS security • SCADA/BMS integration • JSON payloads</p>
        </div>
        <div class="bg-white dark:bg-slate-800 rounded-xl p-6 text-center border border-gray-100 dark:border-slate-700">
          <div class="text-3xl font-extrabold text-purple-600 mb-2">Modbus</div>
          <p class="text-sm text-muted">Industrial RS-485 • Legacy system compatible • Reliable polling</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="py-20 lg:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-default dark:text-slate-100 mb-4">
        Ready to partner with us?
      </h2>
      <p class="text-lg text-muted mb-8 max-w-xl mx-auto">
        Whether you're a distributor, integrator, or OEM brand — we're here to help you build better IoT solutions.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact-sales" class="px-8 py-3.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-semibold shadow-lg shadow-blue-600/25 transition-all hover:shadow-xl">
          Contact Sales →
        </a>
        <a href="/products" class="px-8 py-3.5 rounded-lg border border-gray-300 dark:border-slate-600 text-default dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-800 font-semibold transition-colors">
          Browse Products
        </a>
      </div>
      <div class="mt-12 pt-8 border-t border-gray-100 dark:border-slate-800 grid sm:grid-cols-3 gap-6 text-center">
        <div>
          <p class="text-sm text-muted mb-1">Email</p>
          <a href={`mailto:${email}`} class="font-medium text-blue-600 hover:underline">{email}</a>
        </div>
        <div>
          <p class="text-sm text-muted mb-1">WhatsApp</p>
          <a href="https://wa.me/8618650139895" class="font-medium text-blue-600 hover:underline">+86 186 5013 9895</a>
        </div>
        <div>
          <p class="text-sm text-muted mb-1">Headquarters</p>
          <p class="font-medium text-default dark:text-slate-200">Xiamen, Fujian, China</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
