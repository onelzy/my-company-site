---
// solutions/index.astro — Industry solution listing
// Data from pre-generated src/data/solutions.ts
// Layout: text-first horizontal rows (industry consensus for B2B solution
// lists) — copy carries the message, image supports. Real feature bullets
// come from the solution mdoc "How It Works" sections (never invent).
import PageLayout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import { solutions as rawSolutions } from '~/data/solutions';
import { Icon } from 'astro-icon/components';
import { PRODUCT_TYPE_LABELS, TECH_SOLUTION_LABELS, getLocalizedLabel } from '~/utils/products';

// Static page: build-time render → CDN-cached.
export const prerender = true;

// English MVP — all content is English, skip language filter
const solutions = rawSolutions;

const industries = [
  { value: 'smart-hotels', label: 'Smart Hotels' },
  { value: 'senior-care', label: 'Senior Care' },
  { value: 'energy-management', label: 'Energy Management' },
  { value: 'smart-building', label: 'Smart Building' },
  { value: 'industrial-iot', label: 'Industrial IoT' },
];
const industryIcons: Record<string, string> = {
  'smart-hotels': 'building',
  'senior-care': 'building-hospital',
  'energy-management': 'bolt',
  'smart-building': 'building',
  'industrial-iot': 'building-factory',
};
function getIndustryLabel(value: string): string {
  return industries.find((i) => i.value === value)?.label || '';
}

// Real 3-bullet feature lines per solution, from the mdoc "How It Works"
// sections (condensed display, content unchanged — no fabrication).
const solutionBullets: Record<string, [string, string][]> = {
  'industrial-energy-submetering': [
    ['Per-machine monitoring', 'up to 16 machines per PC341 unit'],
    ['MQTT data stream', 'real-time, SCADA/BMS ready'],
    ['EdgeEco analytics', 'anomaly detection, cost allocation'],
  ],
  'senior-care-monitoring': [
    ['Continuous monitoring', 'SPM-915 under-mattress pads, no wearables'],
    ['Emergency detection', 'falls, inactivity & abnormal vitals'],
    ['Caregiver alerts', 'AiJuan push with room and event type'],
  ],
  'smart-hotel-energy-management': [
    ['Per-room sub-metering', 'PC341 per floor, wing or room'],
    ['Occupancy-aware thermostats', 'PCT513 auto temperature control'],
    ['Central dashboard', 'EdgeEco analytics, alerts, energy reports'],
  ],
};

const preparedSolutions = solutions.map((s) => {
  const d = s.data as Record<string, string | number | string[]>;
  return {
    slug: s.slug,
    title: d.title as string | undefined,
    subtitle: d.subtitle as string | undefined,
    heroImage: d.heroImage as string | undefined,
    industry: d.industry as string | undefined,
    indLabel: getIndustryLabel((d.industry as string) || ''),
    icon: industryIcons[(d.industry as string) || ''] || 'building',
    productLines: (d.productLines as string[]) || [],
    techSolution: d.techSolution as string | undefined,
    bullets: solutionBullets[s.slug] || [],
  };
});
const solutionCount = preparedSolutions.length;
---

<PageLayout
  metadata={{
    title: 'Solutions',
    description:
      'End-to-end OWON IoT deployments for industrial energy, senior care and smart hotels — hardware, connectivity and platform.',
  }}
>
  <section class="py-8 lg:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="mb-10">
        <nav class="mb-4 text-sm text-muted dark:text-slate-400" aria-label="Breadcrumb">
          <a href="/" class="hover:text-primary transition-colors">Home</a>
          <span class="mx-2">/</span>
          <span class="text-default dark:text-slate-200">Solutions</span>
        </nav>
        <h1 class="text-4xl font-extrabold tracking-tight text-default dark:text-slate-100">Solutions</h1>
        <p class="text-lg text-muted dark:text-slate-400 mt-2">
          End-to-end OWON deployments — hardware, connectivity and platform — for industrial energy, senior care and
          smart hotels. <strong id="solutionCount" class="font-semibold text-default dark:text-slate-200"
            >{solutionCount}</strong
          > solutions.
        </p>
      </div>

      <!-- Search -->
      <div class="mb-8">
        <div class="relative max-w-md">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-gray-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg
            >
          </span>
          <input
            type="text"
            id="solutionSearch"
            placeholder="Search by industry or keyword"
            class="w-full pl-10 pr-4 py-2.5 rounded-full border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-default dark:text-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-shadow"
          />
        </div>
      </div>

      <!-- Industry filters (quiet chip system, same as products) -->
      <div class="flex items-center gap-2 flex-wrap mb-10" id="industryFilters">
        <span class="text-xs font-semibold text-gray-700 dark:text-slate-300 uppercase tracking-wider shrink-0"
          >Industry:</span
        >
        <button class="filter-chip chip chip-active active" data-industry="">All</button>
        {
          industries.map((ind) => (
            <button class="filter-chip chip chip-idle" data-industry={ind.value}>
              {ind.label}
            </button>
          ))
        }
      </div>

      <!-- Text-first rows -->
      <div id="solGrid" class="space-y-8">
        {
          preparedSolutions.map((s) => (
            <a
              href={`/solutions/${s.slug}`}
              class="solution-card group block rounded-3xl bg-gray-50 dark:bg-slate-800 hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors duration-300 overflow-hidden"
              data-industry={s.industry || ''}
            >
              <article class="grid md:grid-cols-3">
                {/* Copy block: 2/3, carries the message */}
                <div class="md:col-span-2 p-8 md:p-10 flex flex-col justify-center order-2 md:order-1">
                  {s.indLabel && (
                    <span class="inline-flex self-start mb-3 px-3 py-1 rounded-full text-xs font-bold bg-primary/10 text-primary">
                      {s.indLabel}
                    </span>
                  )}
                  <h2 class="text-2xl md:text-[28px] font-bold tracking-tight leading-snug text-default dark:text-slate-200 group-hover:text-primary transition-colors">
                    {s.title}
                  </h2>
                  {s.subtitle && (
                    <p class="text-[15px] text-muted dark:text-slate-400 mt-3 leading-relaxed">{s.subtitle}</p>
                  )}
                  {s.bullets.length > 0 && (
                    <ul class="mt-6 space-y-2.5">
                      {s.bullets.map(([k, v]) => (
                        <li class="flex items-start gap-2.5">
                          <svg
                            class="w-4 h-4 text-primary shrink-0 mt-0.5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2.5"
                              d="M5 13l4 4L19 7"
                            />
                          </svg>
                          <span class="text-sm text-muted dark:text-slate-400">
                            <strong class="font-semibold text-default dark:text-slate-200">{k}</strong> — {v}
                          </span>
                        </li>
                      ))}
                    </ul>
                  )}
                  <div class="mt-6 flex items-center gap-2 flex-wrap text-sm text-muted dark:text-slate-400">
                    {s.productLines.map((pl, i) => (
                      <>
                        {i > 0 && <span class="text-gray-300 dark:text-slate-600">·</span>}
                        <span>{getLocalizedLabel(PRODUCT_TYPE_LABELS, pl, 'en')}</span>
                      </>
                    ))}
                    {s.techSolution && (
                      <>
                        <span class="text-gray-300 dark:text-slate-600">·</span>
                        <span>{getLocalizedLabel(TECH_SOLUTION_LABELS, s.techSolution, 'en')}</span>
                      </>
                    )}
                  </div>
                  <p class="text-primary font-semibold text-sm mt-7 group-hover:translate-x-1 transition-transform">
                    Explore solution →
                  </p>
                </div>
                {/* Image block: 1/3, supporting */}
                <div class="relative aspect-video md:aspect-auto md:min-h-[300px] bg-gray-200 dark:bg-slate-700 order-1 md:order-2">
                  {s.heroImage ? (
                    <Image
                      src={s.heroImage}
                      alt={s.title || ''}
                      layout="cover"
                      class="absolute inset-0 w-full h-full group-hover:scale-[1.02] transition-transform duration-500"
                      width={600}
                      height={600}
                    />
                  ) : (
                    <div class="absolute inset-0 flex items-center justify-center text-5xl">
                      <Icon name={`tabler:${s.icon}`} class="w-8 h-8" />
                    </div>
                  )}
                </div>
              </article>
            </a>
          ))
        }
        {
          solutions.length === 0 && (
            <div class="text-center py-16 text-muted dark:text-slate-400">
              <p class="text-lg">No solutions yet.</p>
            </div>
          )
        }
        <div id="solutionEmpty" class="text-center py-16 text-muted dark:text-slate-400" style="display:none">
          <p class="text-lg">No solutions match this industry filter.</p>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script is:inline src="/scripts/solution-filter.js"></script>
