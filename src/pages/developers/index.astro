---
export const prerender = true;
import PageLayout from '~/layouts/PageLayout.astro';
import DevSidebar from '~/components/widgets/DevSidebar.astro';
import { Icon } from 'astro-icon/components';

const methods = [
  {
    id: 'A',
    title: 'Method A · Cloud-to-Cloud',
    tag: 'Server API',
    desc: 'Your server connects to the OWON cloud. Gateways stay on OWON servers; data and commands are forwarded to your platform over HTTP/HTTPS with agent credentials. Fastest way to get device data into your own system.',
    docs: ['Server API', 'Gateway API'],
    icon: 'tabler:cloud-data-connection',
    href: '/developers/api',
    fit: 'SaaS platforms, cloud integrators, quick pilots',
  },
  {
    id: 'B',
    title: 'Method B · Gateway-to-Server',
    tag: 'MQTT / TCP',
    desc: 'The OWON gateway connects directly to your own server — all data management lives on your side, no OWON cloud in the loop. MQTT topics or a persistent TCP link with a documented frame protocol.',
    docs: ['Gateway API', 'MQTT Topic Definition', 'TCP Mechanism'],
    icon: 'tabler:server-2',
    href: '/developers/mqtt',
    fit: 'Private deployments, energy-management platforms, data-sensitive customers',
  },
  {
    id: 'D',
    title: 'Method D · Devices to Your Gateway',
    tag: 'ZigBee 3.0',
    desc: 'Use OWON ZigBee end devices with your own coordinator or hub. Devices exchange standard ZCL data with your gateway — a cluster list per device family is provided.',
    docs: ['Device Cluster List'],
    icon: 'tabler:transform',
    href: '/developers/zigbee',
    fit: 'Hub makers, building-automation controllers, custom gateways',
  },
  {
    id: 'U',
    title: 'UART · Gateway Board Inside Your Device',
    tag: 'PCB Integration',
    desc: 'Take the gateway PCB out of an OWON gateway and dock it to your own MCU over UART. Your product gains a full ZigBee 3.0 master + cloud client, controlled via the same Gateway API command set.',
    docs: ['UART Integration Guide', 'Gateway API'],
    icon: 'tabler:circuit-switch-open',
    href: '/contact',
    fit: 'OEM / ODM device manufacturers',
  },
];

const facts = [
  { k: 'Device families', v: 'Meters · Thermostats · Gateways · Sensors' },
  { k: 'Radios', v: 'ZigBee 3.0 · Wi-Fi · RS-485/Modbus · BLE (config)' },
  { k: 'Protocols', v: 'MQTT · HTTP/HTTPS · TCP · UART' },
  { k: 'Firmware', v: 'OTA updates on all devices' },
];
---

<PageLayout
  metadata={{
    title: 'Developer Center — Integrate OWON Devices',
    description:
      'Four official integration paths for OWON smart meters, thermostats and gateways: cloud-to-cloud Server API, direct MQTT/TCP to your own server, ZigBee devices to your coordinator, or the gateway board via UART.',
  }}
>
  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex gap-8">
        <DevSidebar currentPage="overview" />

        <div class="flex-1 min-w-0">
          <!-- Breadcrumb -->
          <nav class="mb-4 text-sm text-muted dark:text-slate-400" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary transition-colors">Home</a>
            <span class="mx-2">/</span>
            <span class="text-default dark:text-slate-200">Developers</span>
          </nav>

          <!-- Mobile tabs -->
          <div class="lg:hidden mb-8 -mx-4 px-4 overflow-x-auto scrollbar-none">
            <div class="flex gap-1.5 min-w-max pb-1">
              <a href="/developers" class="inline-flex shrink-0 chip chip-active no-underline">Integration Overview</a>
              <a href="/developers/api" class="inline-flex shrink-0 chip chip-idle no-underline"
                >Method A · Server API</a
              >
              <a href="/developers/mqtt" class="inline-flex shrink-0 chip chip-idle no-underline">Method B · MQTT/TCP</a
              >
              <a href="/developers/zigbee" class="inline-flex shrink-0 chip chip-idle no-underline">Method D · ZigBee</a
              >
              <a href="/developers/examples" class="inline-flex shrink-0 chip chip-idle no-underline">Samples</a>
            </div>
          </div>

          <h1 class="text-3xl font-bold mb-2 text-default dark:text-slate-100">Developer Center</h1>
          <p class="text-muted dark:text-slate-400 mb-8 max-w-3xl">
            OWON devices integrate with your platform through four documented paths. This portal summarizes how each one
            works so you can pick the right architecture. Full specifications — Server API, Gateway API, MQTT topic and
            payload definitions, TCP framing, device model tables and per-device cluster lists — are provided by our
            engineering team on request.
          </p>

          <!-- Architecture at a glance -->
          <section class="mb-12">
            <h2 class="text-2xl font-bold mb-6 text-default dark:text-slate-100">System at a Glance</h2>
            <div class="rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-6 mb-6">
              <div class="flex flex-col md:flex-row items-stretch gap-4 text-center text-sm">
                <div class="flex-1 rounded-lg bg-gray-50 dark:bg-slate-900 p-4">
                  <Icon name="tabler:devices" class="w-6 h-6 mx-auto mb-2 text-primary" />
                  <p class="font-semibold text-default dark:text-slate-200">OWON Devices</p>
                  <p class="text-muted dark:text-slate-400 mt-1">Meters, thermostats, sensors, HVAC controls</p>
                  <p class="font-mono text-[11px] text-muted mt-2">ZigBee 3.0 / Wi-Fi / RS-485</p>
                </div>
                <div class="flex items-center justify-center text-muted">
                  <Icon name="tabler:arrows-right-left" class="w-5 h-5 rotate-90 md:rotate-0" />
                </div>
                <div class="flex-1 rounded-lg bg-gray-50 dark:bg-slate-900 p-4">
                  <Icon name="tabler:router" class="w-6 h-6 mx-auto mb-2 text-primary" />
                  <p class="font-semibold text-default dark:text-slate-200">Gateway</p>
                  <p class="text-muted dark:text-slate-400 mt-1">ZigBee master, local logic, OTA</p>
                  <p class="font-mono text-[11px] text-muted mt-2">MQTT / TCP / UART</p>
                </div>
                <div class="flex items-center justify-center text-muted">
                  <Icon name="tabler:arrows-right-left" class="w-5 h-5 rotate-90 md:rotate-0" />
                </div>
                <div class="flex-1 rounded-lg bg-gray-50 dark:bg-slate-900 p-4">
                  <Icon name="tabler:server-cog" class="w-6 h-6 mx-auto mb-2 text-primary" />
                  <p class="font-semibold text-default dark:text-slate-200">Your Server</p>
                  <p class="text-muted dark:text-slate-400 mt-1">Direct (Method B) or via OWON cloud (Method A)</p>
                  <p class="font-mono text-[11px] text-muted mt-2">HTTP/HTTPS · MQTT broker · TCP socket</p>
                </div>
              </div>
            </div>
            <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {
                facts.map((f) => (
                  <div class="rounded-lg border border-gray-200 dark:border-slate-700 p-4">
                    <dt class="text-xs uppercase tracking-wide text-muted dark:text-slate-500">{f.k}</dt>
                    <dd class="text-sm font-medium text-default dark:text-slate-200 mt-1">{f.v}</dd>
                  </div>
                ))
              }
            </dl>
          </section>

          <!-- Four integration methods -->
          <section class="mb-12">
            <h2 class="text-2xl font-bold mb-2 text-default dark:text-slate-100">Choose Your Integration Path</h2>
            <p class="text-muted dark:text-slate-400 mb-8">
              Every path ships with its own specification document. Google Home / Alexa / IFTTT bridges are built on
              your own server in all methods.
            </p>
            <div class="grid gap-6 md:grid-cols-2">
              {
                methods.map((m) => (
                  <a
                    href={m.href}
                    class="group rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-6 hover:border-primary/40 hover:shadow-md transition-all no-underline"
                  >
                    <div class="flex items-center gap-3 mb-3">
                      <Icon name={m.icon} class="w-7 h-7 text-primary" />
                      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold font-mono bg-primary/10 dark:bg-primary/20 text-primary">
                        {m.tag}
                      </span>
                    </div>
                    <h3 class="text-lg font-semibold text-default dark:text-slate-200 mb-2">{m.title}</h3>
                    <p class="text-sm text-muted dark:text-slate-400 leading-relaxed mb-4">{m.desc}</p>
                    <p class="text-xs text-muted dark:text-slate-500 mb-3">
                      <span class="font-semibold text-default dark:text-slate-300">Best for:</span> {m.fit}
                    </p>
                    <div class="flex flex-wrap gap-1.5">
                      {m.docs.map((d) => (
                        <span class="inline-flex items-center px-2 py-0.5 rounded bg-gray-100 dark:bg-slate-700 text-[11px] text-muted dark:text-slate-300 font-mono">
                          {d}
                        </span>
                      ))}
                    </div>
                  </a>
                ))
              }
            </div>
          </section>

          <!-- What you get / what stays private -->
          <section
            class="mb-12 rounded-xl border border-blue-200 dark:border-blue-900 bg-blue-50/60 dark:bg-blue-950/40 p-6"
          >
            <h2 class="text-lg font-semibold mb-3 text-default dark:text-slate-100 flex items-center gap-2">
              <Icon name="tabler:file-description" class="w-5 h-5 text-primary" /> Full Documentation on Request
            </h2>
            <p class="text-sm text-muted dark:text-slate-400 leading-relaxed mb-4">
              This portal gives you the architecture overview. The complete integration package — Authentication
              (agentId/agentKey → accessToken), gateway MQTT topic &amp; payload specs, TCP frame protocol, the 90+
              model device-model mapping table, PCT-series device APIs, cluster lists and sample sequences — is
              delivered as official documents by our engineering team, together with the credentials your project needs.
            </p>
            <div class="flex flex-wrap gap-3">
              <a
                href="/contact"
                class="inline-flex items-center gap-2 rounded-full bg-primary hover:bg-primary/90 text-white font-medium px-6 py-2.5 transition-colors no-underline text-sm"
              >
                <Icon name="tabler:mail" class="w-4 h-4" /> Request Integration Docs
              </a>
              <a
                href="https://wa.me/8618650139895"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-full border border-primary/40 text-primary hover:bg-primary/5 dark:hover:bg-primary/10 font-medium px-6 py-2.5 transition-colors no-underline text-sm"
              >
                <Icon name="tabler:brand-whatsapp" class="w-4 h-4" /> WhatsApp an Engineer
              </a>
            </div>
          </section>

          <!-- FAQ teaser -->
          <section class="mb-4">
            <h2 class="text-xl font-semibold mb-4 text-default dark:text-slate-100">Common Questions</h2>
            <div class="space-y-4 text-sm">
              <div class="rounded-lg border border-gray-200 dark:border-slate-700 p-4">
                <p class="font-semibold text-default dark:text-slate-200">Which method should I pick?</p>
                <p class="text-muted dark:text-slate-400 mt-1">
                  Cloud-to-cloud pilot → Method A. Private / on-prem platform or data must not touch OWON servers →
                  Method B. You already run a ZigBee hub → Method D. You build your own hardware → UART board.
                </p>
              </div>
              <div class="rounded-lg border border-gray-200 dark:border-slate-700 p-4">
                <p class="font-semibold text-default dark:text-slate-200">Do devices work without internet?</p>
                <p class="text-muted dark:text-slate-400 mt-1">
                  Yes. OWON gateways keep local ZigBee control and device interoperation running offline; data and
                  commands sync when the link is back.
                </p>
              </div>
              <div class="rounded-lg border border-gray-200 dark:border-slate-700 p-4">
                <p class="font-semibold text-default dark:text-slate-200">How do I get API credentials?</p>
                <p class="text-muted dark:text-slate-400 mt-1">
                  agentId / agentKey (and access tokens) are provisioned per project by our team —
                  <a href="/contact" class="text-primary underline">contact us</a> with your use case.
                </p>
              </div>
              <div class="rounded-lg border border-gray-200 dark:border-slate-700 p-4">
                <p class="font-semibold text-default dark:text-slate-200">
                  Can I control devices and read energy data?
                </p>
                <p class="text-muted dark:text-slate-400 mt-1">
                  Both ways: telemetry uplink (energy, temperature, status) and command downlink (relay, setpoint,
                  configuration) are defined per device family in the Gateway API document.
                </p>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
