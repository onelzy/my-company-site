---
export const prerender = true;
import PageLayout from '~/layouts/PageLayout.astro';
import DevSidebar from '~/components/widgets/DevSidebar.astro';
import { Icon } from 'astro-icon/components';

const LBRACE = '{';
const RBRACE = '}';

const topics = [
  {
    dir: 'sub',
    topic: 'api/device/{deviceid}/{appclientid}',
    what: 'Commands to the gateway from an app/client. deviceid = gateway MAC; appclientid is the command source (subscribe with + wildcard).',
  },
  { dir: 'sub', topic: 'reply/device/cloud/{deviceid}', what: 'Responses to commands the gateway sent to the server.' },
  {
    dir: 'pub',
    topic: 'device/{deviceid}/report',
    what: 'Telemetry uplink: the gateway reports device data (energy, temperature, status…).',
  },
  {
    dir: 'pub',
    topic: 'reply/device/{deviceid}/{appclientid}',
    what: 'The gateway returns execution results of app commands.',
  },
  {
    dir: 'pub',
    topic: 'api/device/cloud/{ModelId}/{deviceid}',
    what: 'Requests from the gateway to the server (e.g. cloud lookups).',
  },
];

const frameCode = `# Application-layer framing on the TCP stream
0x02 (STX) + UTF-8 JSON payload + 0x03 (ETX)

# Example — temperature report
0x02 ${LBRACE}"type":"update","command":"temp",
      "argument":${LBRACE}"ieee":"F7220100007A1300","ep":1,"temp":2200${RBRACE}${RBRACE} 0x03

# Rules
- Bare 0x02 / 0x03 bytes are forbidden inside the JSON;
  encode binary content as Base64 or Hex first.
- Receiver: buffer the stream, cut frames between STX and ETX.
- ETX without STX -> discard; timeout without complete frame
  -> clear buffer; JSON parse failure -> send an error reply.`;

const heartbeatCode = `# Keep-alive + clock sync: every 60 seconds
-> 0x02 ${LBRACE}
     "type":"server","command":"connect",
     "argument":${LBRACE}"mac":"000D6F000D743E53",
       "name":"Your account","version":"X3_HA_V2.5.8_20180317",
       "country":"China","state":"Fujian","zipcode":"361000"${RBRACE}
   ${RBRACE} 0x03

<- 0x02 ${LBRACE}
     "result":true,"type":"server","command":"connect",
     "response":${LBRACE}"utc":579315025,"mac":"000D6F000D743E53"${RBRACE}
   ${RBRACE} 0x03

# Device calibrates its RTC from "utc".
# No response N >= 3 times -> treat link as dead and reconnect.`;

const mqttDirect = `# Meters & thermostats can also publish straight to YOUR broker
# (no OWON cloud at all) — Wi-Fi models such as PC3xx-W-MQTT:

Device  --MQTT over TCP-->  Your broker (EMQX / Mosquitto /
                            VerneMQ / AWS IoT Core)
                              ^
Your server subscribes to device topics and publishes commands

# Configure the broker address on the device with the
# "X5 Config Tool" app (App Store) — or build your own
# configurator with our Configuration API.
# 5 steps: prepare broker -> configure device -> device
# publishes -> server subscribes -> server commands back.`;
---

<PageLayout
  metadata={{
    title: 'Method B — Direct MQTT & TCP to Your Server',
    description:
      'Point OWON gateways straight at your own server: documented MQTT topic scheme, TCP frame protocol with 0x02/0x03 JSON framing, 60s heartbeat, and meters that publish directly to your EMQX/Mosquitto broker.',
  }}
>
  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex gap-8">
        <DevSidebar currentPage="mqtt" />
        <div class="flex-1 min-w-0">
          <nav class="mb-4 text-sm text-muted dark:text-slate-400" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary transition-colors">Home</a>
            <span class="mx-2">/</span>
            <a href="/developers" class="hover:text-primary transition-colors">Developers</a>
            <span class="mx-2">/</span>
            <span class="text-default dark:text-slate-200">Method B · MQTT/TCP</span>
          </nav>

          <div class="lg:hidden mb-8 -mx-4 px-4 overflow-x-auto scrollbar-none">
            <div class="flex gap-1.5 min-w-max pb-1">
              <a href="/developers" class="inline-flex shrink-0 chip chip-idle no-underline">Integration Overview</a>
              <a href="/developers/api" class="inline-flex shrink-0 chip chip-idle no-underline"
                >Method A · Server API</a
              >
              <a href="/developers/mqtt" class="inline-flex shrink-0 chip chip-active no-underline"
                >Method B · MQTT/TCP</a
              >
              <a href="/developers/zigbee" class="inline-flex shrink-0 chip chip-idle no-underline">Method D · ZigBee</a
              >
              <a href="/developers/examples" class="inline-flex shrink-0 chip chip-idle no-underline">Samples</a>
            </div>
          </div>

          <h1 class="text-3xl font-bold mb-2 text-default dark:text-slate-100">
            Method B · <span class="text-primary">Gateway-to-Server</span> (MQTT / TCP)
          </h1>
          <p class="text-muted dark:text-slate-400 mb-8 max-w-3xl">
            The OWON gateway connects directly to a server you operate — all data management lives on your side, with no
            OWON cloud in the loop. Choose MQTT topics or a persistent TCP socket; energy meters and thermostats can
            also publish straight to your own broker.
          </p>

          <!-- Topic scheme -->
          <section class="mb-10">
            <h2 class="text-xl font-semibold mb-3 text-default dark:text-slate-100">1 · Gateway MQTT Topics</h2>
            <p class="text-sm text-muted dark:text-slate-400 mb-4">
              <span class="font-mono text-[13px]">deviceid</span> is the gateway MAC address. Payloads carry the full Gateway
              API command/response package.
            </p>
            <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-slate-700">
              <table class="w-full text-sm">
                <thead class="bg-gray-50 dark:bg-slate-800/80 text-left">
                  <tr>
                    <th class="py-3 px-4 font-semibold text-default dark:text-slate-200">Direction</th>
                    <th class="py-3 px-4 font-semibold text-default dark:text-slate-200">Topic</th>
                    <th class="py-3 px-4 font-semibold text-default dark:text-slate-200">Purpose</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    topics.map((t) => (
                      <tr class="border-t border-gray-100 dark:border-slate-700/60 align-top">
                        <td class="py-3 px-4">
                          <span
                            class:list={[
                              'inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold font-mono',
                              t.dir === 'pub'
                                ? 'bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300'
                                : 'bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300',
                            ]}
                          >
                            {t.dir === 'pub' ? 'PUBLISH' : 'SUBSCRIBE'}
                          </span>
                          <span class="block text-[10px] text-muted mt-1">
                            {t.dir === 'pub' ? 'gateway →' : '→ gateway'}
                          </span>
                        </td>
                        <td class="py-3 px-4 font-mono text-[12.5px] whitespace-nowrap text-primary">{t.topic}</td>
                        <td class="py-3 px-4 text-muted dark:text-slate-300">{t.what}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
            <p class="text-xs text-muted dark:text-slate-500 mt-3">
              Broker address, ACLs and per-project credentials are issued by our engineering team with the full MQTT
              Topic Definition document.
            </p>
          </section>

          <!-- TCP framing -->
          <section class="mb-10">
            <h2 class="text-xl font-semibold mb-3 text-default dark:text-slate-100">2 · TCP Frame Protocol</h2>
            <p class="text-sm text-muted dark:text-slate-400 mb-4">
              Prefer a plain socket? The gateway keeps a persistent TCP connection to your server and solves the
              message-boundary problem with an explicit frame:
            </p>
            <pre
              class="rounded-xl bg-slate-950 text-slate-100 text-[13px] leading-relaxed p-5 overflow-x-auto font-mono"><code>{frameCode}</code></pre>
          </section>

          <!-- Heartbeat -->
          <section class="mb-10">
            <h2 class="text-xl font-semibold mb-3 text-default dark:text-slate-100">3 · Heartbeat &amp; Time Sync</h2>
            <p class="text-sm text-muted dark:text-slate-400 mb-4">
              One 60-second <span class="font-mono text-[13px]">connect</span> message keeps the link alive and lets the device
              sync its clock from the server reply:
            </p>
            <pre
              class="rounded-xl bg-slate-950 text-slate-100 text-[13px] leading-relaxed p-5 overflow-x-auto font-mono"><code>{heartbeatCode}</code></pre>
          </section>

          <!-- Direct-to-broker devices -->
          <section class="mb-10">
            <h2 class="text-xl font-semibold mb-3 text-default dark:text-slate-100">
              4 · Meters &amp; Thermostats Direct to Your Broker
            </h2>
            <p class="text-sm text-muted dark:text-slate-400 mb-4">
              Wi-Fi models (e.g. MQTT-series power meters, PCT-series thermostats) speak MQTT natively — they can
              publish telemetry and accept commands from <em>your</em> broker without a gateway at all:
            </p>
            <pre
              class="rounded-xl bg-slate-950 text-slate-100 text-[13px] leading-relaxed p-5 overflow-x-auto font-mono"><code>{mqttDirect}</code></pre>
          </section>

          <!-- Device model table -->
          <section class="mb-10">
            <h2 class="text-xl font-semibold mb-3 text-default dark:text-slate-100">
              5 · Identifying Devices in Payloads
            </h2>
            <p class="text-sm text-muted dark:text-slate-400 leading-relaxed">
              Payloads reference devices by <span class="font-mono text-[13px]">ieee</span> (device MAC) +
              <span class="font-mono text-[13px]">ep</span> (endpoint), and type by
              <span class="font-mono text-[13px]">devModel</span>. Our device-model mapping table — 90+ models across
              meters, thermostats, HVAC controls, sleep/fall sensors, locks — defines the canonical
              <span class="font-mono text-[13px]"> devModel → model name</span> pairs and ships with the integration package.
            </p>
          </section>

          <!-- CTA -->
          <section
            class="mb-4 rounded-xl border border-blue-200 dark:border-blue-900 bg-blue-50/60 dark:bg-blue-950/40 p-6"
          >
            <h2 class="text-lg font-semibold mb-2 text-default dark:text-slate-100">
              Full MQTT / TCP Documents on Request
            </h2>
            <p class="text-sm text-muted dark:text-slate-400 leading-relaxed mb-4">
              Complete Gateway API command reference, payload field tables, sequence-diagram samples (switching,
              metering, HVAC), broker configuration and the device-model table are provided as official documents by our
              engineering team.
            </p>
            <div class="flex flex-wrap gap-3">
              <a
                href="/contact"
                class="inline-flex items-center gap-2 rounded-full bg-primary hover:bg-primary/90 text-white font-medium px-6 py-2.5 transition-colors no-underline text-sm"
              >
                <Icon name="tabler:mail" class="w-4 h-4" /> Request MQTT/TCP Documents
              </a>
              <a
                href="https://wa.me/8618650139895"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-full border border-primary/40 text-primary hover:bg-primary/5 dark:hover:bg-primary/10 font-medium px-6 py-2.5 transition-colors no-underline text-sm"
              >
                <Icon name="tabler:brand-whatsapp" class="w-4 h-4" /> WhatsApp
              </a>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
