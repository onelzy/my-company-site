---
export const prerender = true;
import PageLayout from '~/layouts/PageLayout.astro';
import DevSidebar from '~/components/widgets/DevSidebar.astro';
import { Icon } from 'astro-icon/components';

const LBRACE = '{';
const RBRACE = '}';

const authCode = `# 1. Obtain an AccessToken  (valid 24h)
POST {OWON_SERVER}/busproc/nt/agent/getaccesstoken
Content-Type: application/json; charset=utf-8

${LBRACE}
  "agentId":  "your_agent_id",     # issued by OWON
  "agentKey": "your_agent_key",    # issued by OWON
  "ts": "586851710"                # seconds since 2000-01-01 00:00:00
${RBRACE}

# Response
${LBRACE}
  "code": "100",                   # 100 = success
  "accessToken":  "...",           # use for the next 24 hours
  "refreshToken": "...",           # use to renew without new credentials
  "ts": "586851710"
${RBRACE}

# 2. Renew before expiry
POST {OWON_SERVER}/busproc/nt/agent/refreshtoken
${LBRACE} "agentId": "...", "refreshToken": "...", "ts": "..." ${RBRACE}`;

const queryCode = `# Query the gateways belonging to an end-user account
POST {OWON_SERVER}/busproc/agent/userGw
${LBRACE}
  "agentId": "...", "accessToken": "...",
  "account": "user@example.com", "password": "***",
  "pageno": 1, "pagesize": 10, "ts": "..."
${RBRACE}

# Response — one page of gateways
${LBRACE}
  "code": "100", "msg": "success",
  "response": ${LBRACE}
    "pageno": 1, "pagesize": 10, "total": 2,
    "rows": [
      ${LBRACE}
        "mac": "ACDD11A...",        # gateway MAC = unique id
        "name": "gateway1",
        "online": 1,                 # 1 online / 0 offline
        "gversion": "X3_HA_V2.5.10_20180417",
        "devmodel": "X3",
        "timezone": 8, "status": 1
      ${RBRACE}
    ]
  ${RBRACE}
${RBRACE}`;

const sendCode = `# Send a command to a gateway (forwarded by OWON cloud)
POST {OWON_SERVER}/busproc/agent/sendGwData
${LBRACE}
  "agentId": "...", "accessToken": "...",
  "mac": "ACDD11A...",              # target gateway
  "data": ${LBRACE} ... ${RBRACE},               # Gateway API command JSON
  "ts": "..."
${RBRACE}

# Device telemetry uplink: provide a URL at onboarding —
# the OWON server POSTs forwarded device data to it.`;

const codes = [
  ['100', 'Success'],
  ['101', 'Failure'],
  ['102', 'Requests too frequent / wrong account or password'],
  ['103', 'agentKey or accessToken not valid'],
  ['104', 'Account locked after 10 failed verifications (retry in 20 min)'],
  ['106', 'accessToken expired — refresh it'],
];
---

<PageLayout
  metadata={{
    title: 'Method A — Cloud-to-Cloud Server API',
    description:
      'Integrate OWON devices through the OWON 6000 cloud: authenticate with agentId/agentKey, get a 24-hour accessToken, query gateways, send commands, and receive forwarded device data on your URL.',
  }}
>
  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex gap-8">
        <DevSidebar currentPage="api" />
        <div class="flex-1 min-w-0">
          <nav class="mb-4 text-sm text-muted dark:text-slate-400" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary transition-colors">Home</a>
            <span class="mx-2">/</span>
            <a href="/developers" class="hover:text-primary transition-colors">Developers</a>
            <span class="mx-2">/</span>
            <span class="text-default dark:text-slate-200">Method A · Server API</span>
          </nav>

          <div class="lg:hidden mb-8 -mx-4 px-4 overflow-x-auto scrollbar-none">
            <div class="flex gap-1.5 min-w-max pb-1">
              <a href="/developers" class="inline-flex shrink-0 chip chip-idle no-underline">Integration Overview</a>
              <a href="/developers/api" class="inline-flex shrink-0 chip chip-active no-underline"
                >Method A · Server API</a
              >
              <a href="/developers/mqtt" class="inline-flex shrink-0 chip chip-idle no-underline">Method B · MQTT/TCP</a
              >
              <a href="/developers/zigbee" class="inline-flex shrink-0 chip chip-idle no-underline">Method D · ZigBee</a
              >
              <a href="/developers/examples" class="inline-flex shrink-0 chip chip-idle no-underline">Samples</a>
            </div>
          </div>

          <h1 class="text-3xl font-bold mb-2 text-default dark:text-slate-100">
            Method A · Cloud-to-Cloud <span class="text-primary">Server API</span>
          </h1>
          <p class="text-muted dark:text-slate-400 mb-8 max-w-3xl">
            Your server talks to the OWON 6000 cloud; the cloud talks to the gateways. Gateways keep their normal OWON
            setup, and you get device data and control through a small set of HTTP/JSON endpoints — the fastest path to
            production. If you need data to bypass the OWON cloud entirely, use
            <a href="/developers/mqtt" class="text-primary underline">Method B</a> instead.
          </p>

          <div class="rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-5 mb-10">
            <div class="flex flex-wrap items-center gap-3 text-sm">
              <Icon name="tabler:route" class="w-5 h-5 text-primary" />
              <span class="font-mono text-xs text-muted dark:text-slate-400">
                Your devices → OWON Gateway → (socket) → OWON Cloud → (HTTP/JSON) → Your Server
              </span>
            </div>
          </div>

          <!-- Credentials -->
          <section class="mb-10">
            <h2 class="text-xl font-semibold mb-3 text-default dark:text-slate-100">1 · Credentials &amp; Address</h2>
            <p class="text-sm text-muted dark:text-slate-400 mb-4 leading-relaxed">
              OWON issues each project an <span class="font-mono text-[13px]">agentId</span> and
              <span class="font-mono text-[13px]">agentKey</span>, together with the server address for your deployment
              (ask sales). Every request carries a timestamp in <em>seconds since 2000-01-01 00:00:00</em> — note the non-standard
              epoch.
            </p>
            <p class="text-sm text-muted dark:text-slate-400 leading-relaxed">
              You also register a <span class="font-mono text-[13px]">callback URL</span>: the OWON server POSTs device
              data forwarded from your gateways to that URL, so telemetry uplink and command downlink stay symmetric
              with your own backend design.
            </p>
          </section>

          <!-- Auth flow -->
          <section class="mb-10">
            <h2 class="text-xl font-semibold mb-3 text-default dark:text-slate-100">2 · Authentication</h2>
            <p class="text-sm text-muted dark:text-slate-400 mb-4">
              Exchange agent credentials for an <span class="font-mono text-[13px]">accessToken</span> valid for 24 hours;
              renew with the <span class="font-mono text-[13px]">refreshToken</span> before expiry.
            </p>
            <pre
              class="rounded-xl bg-slate-950 text-slate-100 text-[13px] leading-relaxed p-5 overflow-x-auto font-mono"><code>{authCode}</code></pre>
          </section>

          <!-- Typical queries -->
          <section class="mb-10">
            <h2 class="text-xl font-semibold mb-3 text-default dark:text-slate-100">3 · Query &amp; Control</h2>
            <p class="text-sm text-muted dark:text-slate-400 mb-4">
              Verify end-user accounts, page through their gateways (online state, firmware version, model), and send
              Gateway API commands through the cloud:
            </p>
            <pre
              class="rounded-xl bg-slate-950 text-slate-100 text-[13px] leading-relaxed p-5 overflow-x-auto font-mono mb-4"><code>{queryCode}</code></pre>
            <pre
              class="rounded-xl bg-slate-950 text-slate-100 text-[13px] leading-relaxed p-5 overflow-x-auto font-mono"><code>{sendCode}</code></pre>
          </section>

          <!-- Response codes -->
          <section class="mb-10">
            <h2 class="text-xl font-semibold mb-3 text-default dark:text-slate-100">4 · Response Codes</h2>
            <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-slate-700">
              <table class="w-full text-sm">
                <tbody>
                  {
                    codes.map(([c, d]) => (
                      <tr class="border-b border-gray-100 dark:border-slate-700/60 last:border-0">
                        <td class="py-2.5 px-4 font-mono text-primary whitespace-nowrap">{c}</td>
                        <td class="py-2.5 px-4 text-muted dark:text-slate-300">{d}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </section>

          <!-- Full doc CTA -->
          <section
            class="mb-4 rounded-xl border border-blue-200 dark:border-blue-900 bg-blue-50/60 dark:bg-blue-950/40 p-6"
          >
            <h2 class="text-lg font-semibold mb-2 text-default dark:text-slate-100">
              Full Server API Document on Request
            </h2>
            <p class="text-sm text-muted dark:text-slate-400 leading-relaxed mb-4">
              The complete specification — every command, field-by-field payload tables, data-forwarding format, OTA and
              gateway-management functions, and worked examples — is delivered as an official document along with your
              agentId/agentKey when a project starts.
            </p>
            <div class="flex flex-wrap gap-3">
              <a
                href="/contact"
                class="inline-flex items-center gap-2 rounded-full bg-primary hover:bg-primary/90 text-white font-medium px-6 py-2.5 transition-colors no-underline text-sm"
              >
                <Icon name="tabler:mail" class="w-4 h-4" /> Request Server API Document
              </a>
              <a
                href="https://wa.me/8618650139895"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-full border border-primary/40 text-primary hover:bg-primary/5 dark:hover:bg-primary/10 font-medium px-6 py-2.5 transition-colors no-underline text-sm"
              >
                <Icon name="tabler:brand-whatsapp" class="w-4 h-4" /> WhatsApp
              </a>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
