---
export const prerender = true;
import PageLayout from '~/layouts/PageLayout.astro';
import DevSidebar from '~/components/widgets/DevSidebar.astro';
import { Icon } from 'astro-icon/components';

const LBRACE = '{';
const RBRACE = '}';

const controlFlow = `# Method B — switching a socket, end to end
# (official Gateway MQTT sample sequence)

1. You PUBLISH the command:
   topic  api/device/{gateway_mac}/{your_client_id}
   payload 0x02 ${LBRACE}
     "type":"request","command":"set",
     "mac":"000D6F000D743E53",
     "clusterid":"0x0006","endpoint":1,
     "data":${LBRACE}"onoff":true${RBRACE}
   ${RBRACE} 0x03

2. Gateway executes on ZigBee, then REPLIES to you:
   topic  reply/device/{gateway_mac}/{your_client_id}
   payload ${LBRACE}"result":true,"command":"set"${RBRACE}

3. Gateway PUBLISHES the new state (report uplink):
   topic  device/{gateway_mac}/report
   payload ${LBRACE}
     "type":"update","command":"loadstate",
     "argument":${LBRACE}"ieee":"F72201000...","ep":1,
       "power":58.2,"energy":12.44${RBRACE}
   ${RBRACE}`;

const telemetryFlow = `# Energy meter reading arrives unprompted
topic   device/{gateway_mac}/report
payload ${LBRACE}
  "type":"update","command":"energy",
  "argument":${LBRACE}
    "ieee":"00124B001EAC010A","ep":1,
    "voltage":238.6,          # V
    "current":[1.24,0.0,0.0], # A per phase
    "activePower":-296.04,    # W (signed)
    "totalEnergy":32.16       # kWh cumulative
  ${RBRACE}
${RBRACE}

# Subscribe once; every meter under the gateway
# streams through the same topic family.`;

const connectFlow = `# Keep-alive every 60s — one message does two jobs
-> ${LBRACE}"type":"server","command":"connect",
    "argument":${LBRACE}"mac":"000D6F000D743E53",
      "version":"X3_HA_V2.5.8_20180317"${RBRACE}${RBRACE}

<- ${LBRACE}"result":true,"type":"server","command":"connect",
    "response":${LBRACE}"utc":579315025,
      "mac":"000D6F000D743E53"${RBRACE}${RBRACE}

# 1. Link stays alive  2. Device RTC syncs from "utc"
# (seconds since 2000-01-01 — the OWON epoch)
# Miss >= 3 replies -> reconnect.`;
---

<PageLayout
  metadata={{
    title: 'Integration Samples — OWON Gateway MQTT / TCP',
    description:
      'Real message flows from the OWON integration package: socket switching command-reply-report sequence, energy telemetry uplink, and the 60-second heartbeat with time sync.',
  }}
>
  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex gap-8">
        <DevSidebar currentPage="examples" />
        <div class="flex-1 min-w-0">
          <nav class="mb-4 text-sm text-muted dark:text-slate-400" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary transition-colors">Home</a>
            <span class="mx-2">/</span>
            <a href="/developers" class="hover:text-primary transition-colors">Developers</a>
            <span class="mx-2">/</span>
            <span class="text-default dark:text-slate-200">Samples</span>
          </nav>

          <div class="lg:hidden mb-8 -mx-4 px-4 overflow-x-auto scrollbar-none">
            <div class="flex gap-1.5 min-w-max pb-1">
              <a href="/developers" class="inline-flex shrink-0 chip chip-idle no-underline">Integration Overview</a>
              <a href="/developers/api" class="inline-flex shrink-0 chip chip-idle no-underline"
                >Method A · Server API</a
              >
              <a href="/developers/mqtt" class="inline-flex shrink-0 chip chip-idle no-underline">Method B · MQTT/TCP</a
              >
              <a href="/developers/zigbee" class="inline-flex shrink-0 chip chip-idle no-underline">Method D · ZigBee</a
              >
              <a href="/developers/examples" class="inline-flex shrink-0 chip chip-active no-underline">Samples</a>
            </div>
          </div>

          <h1 class="text-3xl font-bold mb-2 text-default dark:text-slate-100">
            Integration <span class="text-primary">Samples</span>
          </h1>
          <p class="text-muted dark:text-slate-400 mb-8 max-w-3xl">
            Message flows taken directly from the official integration package (Method B samples document). These are
            the exact topics, frames and payloads exchanged between an OWON gateway and your server — enough to design
            your handler; the full command dictionary comes with the documents.
          </p>

          <section class="mb-10">
            <h2 class="text-xl font-semibold mb-3 text-default dark:text-slate-100">
              1 · Control a Device (command → reply → report)
            </h2>
            <pre
              class="rounded-xl bg-slate-950 text-slate-100 text-[13px] leading-relaxed p-5 overflow-x-auto font-mono"><code>{controlFlow}</code></pre>
          </section>

          <section class="mb-10">
            <h2 class="text-xl font-semibold mb-3 text-default dark:text-slate-100">2 · Energy Telemetry Uplink</h2>
            <pre
              class="rounded-xl bg-slate-950 text-slate-100 text-[13px] leading-relaxed p-5 overflow-x-auto font-mono"><code>{telemetryFlow}</code></pre>
          </section>

          <section class="mb-10">
            <h2 class="text-xl font-semibold mb-3 text-default dark:text-slate-100">3 · Heartbeat &amp; Time Sync</h2>
            <pre
              class="rounded-xl bg-slate-950 text-slate-100 text-[13px] leading-relaxed p-5 overflow-x-auto font-mono"><code>{connectFlow}</code></pre>
          </section>

          <section class="mb-10 rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-6">
            <h2 class="text-lg font-semibold mb-2 text-default dark:text-slate-100">
              Code Samples &amp; Reference Projects
            </h2>
            <p class="text-sm text-muted dark:text-slate-400 leading-relaxed">
              Runnable reference code (Python/Node service stubs, the official Method B sample controller, the North
              America thermostat Device API with its Flutter example, and broker configuration walkthroughs) is packaged
              per project — tell us your stack and integration path and we send the matching set.
            </p>
          </section>

          <section
            class="mb-4 rounded-xl border border-blue-200 dark:border-blue-900 bg-blue-50/60 dark:bg-blue-950/40 p-6"
          >
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div>
                <h2 class="text-lg font-semibold mb-1 text-default dark:text-slate-100">Request the Full Package</h2>
                <p class="text-sm text-muted dark:text-slate-400">
                  Server API spec · Gateway API command list · MQTT topic definition · TCP protocol · device-model table
                  · samples for your stack.
                </p>
              </div>
              <a
                href="/contact"
                class="inline-flex items-center gap-2 rounded-full bg-primary hover:bg-primary/90 text-white font-medium px-6 py-2.5 transition-colors no-underline text-sm"
              >
                <Icon name="tabler:mail" class="w-4 h-4" /> Request Documents
              </a>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
