---
export const prerender = true;
import PageLayout from '~/layouts/PageLayout.astro';
import DevSidebar from '~/components/widgets/DevSidebar.astro';
import { Icon } from 'astro-icon/components';

const LBRACE = '{';
const RBRACE = '}';

const samples = [
  {
    icon: 'tabler:cloud-data-connection',
    href: '/developers/api',
    title: 'Method A · Cloud to Cloud',
    caption: 'HTTP Server API — obtain a 24-hour accessToken, then call agent APIs',
    code: `# 1. Authenticate with the agentId/agentKey OWON provisions
POST ${'$'}{OWON_SERVER}/busproc/nt/agent/getaccesstoken
Content-Type: application/json; charset=utf-8

${LBRACE}
  "agentId": "testagentid",
  "agentKey": "testkey",
  "cmd": "getaccesstoken"
${RBRACE}

# Response — accessToken valid 24h, refreshToken to renew it
${LBRACE}
  "code": "100",
  "accessToken": "***",
  "refreshToken": "testRe…oken"
${RBRACE}

# 2. Every later call carries agentId + accessToken
${LBRACE} "agentId": ..., "accessToken": ..., "cmd": "userGw" ... ${RBRACE}`,
  },
  {
    icon: 'tabler:server-2',
    href: '/developers/mqtt',
    title: 'Method B · Gateway to Cloud (MQTT)',
    caption: 'Official payload sample — switch a smart plug (entire Gateway API package in the payload)',
    code: `# Publish to the gateway's command topic
api/device/{'$'}{gateway_mac}/{'$'}{your_client_id}

${LBRACE}
  "type": "smartPlug",
  "sequence": 1017,
  "command": "setSwitchgear",
  "argument": ${LBRACE}
    "ieee": "0100000000221100",
    "ep": 1,
    "switchgear": "off"
  ${RBRACE}
${RBRACE}

# Gateway answers on reply/device/{'$'}{gateway_mac}/{'$'}{your_client_id}
${LBRACE}
  "result": true,
  "switchgear": "off",
  "ieee": "0100000000221100",
  "ep": 1,
  "description": "setOnOff back success",
  "sequence": 1017
${RBRACE}

# The docs' own CLI test command:
mosquitto_pub -h broker.xxx.com \\
  -t "api/device/{'$'}{gateway_mac}/{'$'}{client}" \\
  -m '${LBRACE}"type":"smartPlug","sequence":1017,"command":"setSwitchgear","argument":${LBRACE}"ieee":"0100000000221100","ep":1,"switchgear":"off"${RBRACE}${RBRACE}'`,
  },
  {
    icon: 'tabler:transform',
    href: '/developers/zigbee',
    title: 'Method D · Device to Gateway',
    caption: 'ZCL on your coordinator — DWS332 IAS Zone enrollment',
    code: `# Device → your gateway (cluster 0x0500, generated)
ZoneEnrollRequest  zoneType = 0x0015  (contact switch)

# Your gateway → device
ZoneEnrollResponse enrollResponse = SUCCESS

# Every open/close event
ZoneStatusChangeNotification
  zoneStatus bit0 = 1  → opened
  zoneStatus bit0 = 0  → closed`,
  },
  {
    icon: 'tabler:wifi',
    href: '/developers/devices',
    title: 'Wi-Fi Direct · Your Broker',
    caption: 'Real device-side flow from the Device API document — nothing transits OWON',
    code: `# 1. Put the device in configuration mode (BLE or Wi-Fi AP)
#    Configure: Wi-Fi credentials, MQTT broker settings,
#    device identity, MQTT connection parameters,
#    time zone & location — via X5 Config Tool or your
#    own app built on the Configuration API. All
#    application-layer messages are JSON.

# 2. Send startRegister → device exits config mode,
#    joins your Wi-Fi, connects to YOUR broker

# 3. Steady state: device publishes attribute reports
#    (string or raw payloads), your server publishes
#    set-attribute commands; OTA, weather and time
#    sync run over the same broker connection.

# Broker options from the official guide:
EMQX · Mosquitto · VerneMQ · AWS IoT Core`,
  },
];
---

<PageLayout
  metadata={{
    title: 'Integration Samples — OWON Developer Center',
    description:
      'Concrete request and payload samples for each OWON integration path: Server API token flow, MQTT smartPlug command with Gateway API payload, Zigbee IAS Zone enrollment, and Wi-Fi direct broker connection.',
  }}
>
  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex gap-8">
        <DevSidebar currentPage="examples" />

        <div class="flex-1 min-w-0">
          <nav class="mb-4 text-sm text-muted dark:text-slate-400" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary transition-colors">Home</a>
            <span class="mx-2">/</span>
            <a href="/developers" class="hover:text-primary transition-colors">Developers</a>
            <span class="mx-2">/</span>
            <span class="text-default dark:text-slate-200">Samples</span>
          </nav>

          <h1 class="text-3xl font-bold mb-2 text-default dark:text-slate-100">Samples</h1>
          <p class="text-muted dark:text-slate-400 mb-8 max-w-3xl">
            One short, real example per path, taken from the official integration documents. They show the <em>shape</em
            >
            of a working exchange — enough to design against before the full specifications and credentials arrive.
          </p>

          <div class="space-y-8 mb-12">
            {
              samples.map((s, i) => (
                <section>
                  <div class="flex items-center gap-3 mb-1">
                    <Icon name={s.icon} class="w-6 h-6 text-primary" />
                    <h2 class="text-xl font-bold text-default dark:text-slate-100">
                      {i + 1}. {s.title}
                    </h2>
                  </div>
                  <p class="text-sm text-muted dark:text-slate-400 mb-3">{s.caption}</p>
                  <pre class="rounded-lg bg-gray-900 dark:bg-slate-950 text-gray-100 text-[13px] leading-relaxed p-5 overflow-x-auto">
                    <code>{s.code}</code>
                  </pre>
                  <a href={s.href} class="inline-block text-sm text-primary hover:underline mt-2 no-underline">
                    Full details → {s.title}
                  </a>
                </section>
              ))
            }
          </div>

          <section
            class="rounded-xl border border-amber-200 dark:border-amber-900 bg-amber-50/60 dark:bg-amber-950/30 p-6 mb-8"
          >
            <h2 class="text-lg font-semibold mb-2 text-default dark:text-slate-100 flex items-center gap-2">
              <Icon name="tabler:key" class="w-5 h-5 text-primary" /> Where Credentials Come From
            </h2>
            <p class="text-sm text-muted dark:text-slate-400 leading-relaxed">
              agentKey / agentSecret (Method A) are provisioned per project by our engineering team after NDA on
              request; Methods B–D and the Wi-Fi direct line need no OWON credentials at all — the devices talk to
              <strong class="text-default dark:text-slate-200">your</strong> server, broker or coordinator. Endpoint hosts
              and topic names follow the pattern shown; request the specification documents for production values.
            </p>
          </section>

          <section class="rounded-xl border border-gray-200 dark:border-slate-700 p-6">
            <h2 class="text-lg font-semibold mb-3 text-default dark:text-slate-100">Continue</h2>
            <ul class="space-y-2 text-sm">
              <li>
                <a href="/developers" class="text-primary hover:underline no-underline"
                  >Integration Overview — pick your path</a
                >
              </li>
              <li>
                <a href="/developers/uart" class="text-primary hover:underline no-underline"
                  >Method C · UART Gateway Board</a
                >
              </li>
              <li>
                <a href="/developers/mqtt" class="text-primary hover:underline no-underline"
                  >Gateway API command format (shared by Methods A–C)</a
                >
              </li>
              <li>
                <a href="/contact" class="text-primary hover:underline no-underline"
                  >Request the full specification package</a
                >
              </li>
            </ul>
          </section>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
