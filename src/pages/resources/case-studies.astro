---
import PageLayout from '~/layouts/PageLayout.astro';

const stats = [
  { value: '60+', label: 'Countries Deployed' },
  { value: '500+', label: 'Hotel Rooms Monitored' },
  { value: '1,200+', label: 'Apartments Sub-Metered' },
  { value: '32%', label: 'Avg Energy Savings' },
];

const industries = [
  'All',
  'Hospitality',
  'Healthcare',
  'Real Estate',
  'Manufacturing',
  'Energy',
  'Logistics',
];

const caseStudies = [
  {
    id: 'hotel-jakarta',
    featured: true,
    title: '500-Room Hotel Energy Retrofit',
    location: 'Jakarta, Indonesia',
    industry: 'Hospitality',
    region: 'Southeast Asia',
    challenge:
      'A 5-star international hotel chain needed to reduce energy costs across 500 guest rooms without compromising guest comfort. Legacy thermostats and lack of per-room metering made it impossible to identify waste.',
    solution:
      'Deployed OWON PCT513 smart thermostats with HCH-01 hotel control panels in every room. PC341 single-phase meters at each floor distribution panel provide real-time consumption data. The system integrates with the hotel PMS via MQTT API for automated check-in/check-out energy policies.',
    results: [
      { metric: '32%', label: 'Energy Cost Reduction' },
      { metric: '500', label: 'Rooms Monitored' },
      { metric: '14 mo', label: 'ROI Payback' },
      { metric: '4.8★', label: 'Guest Satisfaction' },
    ],
    pdfUrl: '/documents/smart-hotel-solution-brief.pdf',
    pdfLabel: 'Smart Hotel Solution Brief',
  },
  {
    id: 'senior-tokyo',
    featured: false,
    title: 'Smart Senior Care — Multi-Floor Nursing Home',
    location: 'Tokyo, Japan',
    industry: 'Healthcare',
    region: 'Japan',
    challenge:
      'A 6-floor nursing facility needed non-intrusive monitoring for 200+ elderly residents. Traditional camera systems raised privacy concerns, and wired nurse-call buttons had high false-alarm rates.',
    solution:
      'Installed OWON SPM-915 sleep monitors and SCB-01 gateways in each resident room. Motion, presence, and emergency detection algorithms run locally on the gateway, sending alerts only when anomalies are detected — no cameras, no wearables.',
    results: [
      { metric: '200+', label: 'Residents Protected' },
      { metric: '60%', label: 'Faster Response' },
      { metric: '0', label: 'False Alarms' },
      { metric: '25%', label: 'Staff Workload Reduced' },
    ],
    pdfUrl: '/documents/senior-care-solution-overview.pdf',
    pdfLabel: 'Senior Care Solution Overview',
  },
  {
    id: 'dubai-apartments',
    featured: false,
    title: 'Apartment Sub-Metering — 1,200-Unit Complex',
    location: 'Dubai, UAE',
    industry: 'Real Estate',
    region: 'Middle East',
    challenge:
      'A luxury residential complex with 1,200 units had no way to bill tenants individually for energy consumption. Flat-rate billing led to overuse and tenant disputes over fairness.',
    solution:
      'Deployed OWON PC341-TY single-phase WiFi meters in each apartment. Real-time data streams to a tenant portal and integrates with the property management ERP via MQTT API. Each tenant sees their own consumption, cost, and carbon footprint.',
    results: [
      { metric: '1,200', label: 'Meters Installed' },
      { metric: '80%', label: 'Fewer Billing Disputes' },
      { metric: '15%', label: 'Energy Savings' },
      { metric: '24/7', label: 'Tenant Portal Uptime' },
    ],
    pdfUrl: '/documents/single-phase-meter-series.pdf',
    pdfLabel: 'Smart Meter Datasheet',
  },
  {
    id: 'rotterdam-coldchain',
    featured: false,
    title: 'Cold Chain Monitoring — Pharmaceutical Storage',
    location: 'Rotterdam, Netherlands',
    industry: 'Logistics',
    region: 'Europe',
    challenge:
      'Three pharmaceutical cold storage warehouses needed 24/7 temperature monitoring to meet GDP (Good Distribution Practice) compliance. Manual loggers were prone to gaps and human error.',
    solution:
      'Deployed OWON temperature sensors with WiFi gateways across all storage zones. Real-time dashboard with SMS/email alerts triggers on any temperature excursion. Automated compliance reports generated daily.',
    results: [
      { metric: '100%', label: 'GDP Compliance' },
      { metric: '3', label: 'Warehouses Monitored' },
      { metric: '0', label: 'Temperature Excursions' },
      { metric: 'Auto', label: 'Compliance Reports' },
    ],
    pdfUrl: '/documents/industrial-iot-datasheet.pdf',
    pdfLabel: 'Industrial IoT Datasheet',
  },
  {
    id: 'brazil-plant',
    featured: false,
    title: 'Industrial Submetering — Manufacturing Plant',
    location: 'São Paulo, Brazil',
    industry: 'Manufacturing',
    region: 'South America',
    challenge:
      'An automotive parts manufacturer with 40 production lines had a single utility meter for the entire facility. They couldn\'t identify which lines were energy-inefficient or allocate costs to specific product lines.',
    solution:
      'Installed OWON PC342 three-phase meters with RS-485 Modbus RTU on each production line. Data feeds into their SCADA system and energy management dashboard. Granular data revealed 3 high-consumption lines for targeted efficiency upgrades.',
    results: [
      { metric: '$47K', label: 'Annual Savings' },
      { metric: '40', label: 'Production Lines' },
      { metric: '3', label: 'Lines Upgraded' },
      { metric: 'ISO 50001', label: 'Certification Ready' },
    ],
    pdfUrl: '/documents/three-phase-meter-series.pdf',
    pdfLabel: 'Three-Phase Meter Datasheet',
  },
  {
    id: 'kenya-microgrid',
    featured: false,
    title: 'Solar Microgrid Monitoring — Rural Community',
    location: 'Nairobi, Kenya',
    industry: 'Energy',
    region: 'Africa',
    challenge:
      'A solar microgrid serving 200 rural households suffered from load imbalances during peak hours. Without per-household metering, fair billing was impossible and grid stability was unpredictable.',
    solution:
      'Integrated OWON PC321-TY single-phase meters with a 4G gateway at each household connection point. Prepaid billing system with mobile money integration. Real-time load data enables dynamic load balancing across phases.',
    results: [
      { metric: '200', label: 'Households Served' },
      { metric: '40%', label: 'Grid Stability Improvement' },
      { metric: 'Mobile', label: 'Pay-as-You-Go Billing' },
      { metric: '4G', label: 'Remote Monitoring' },
    ],
    pdfUrl: '/documents/single-phase-meter-series.pdf',
    pdfLabel: 'Smart Meter Datasheet',
  },
];

const featuredStudy = caseStudies.find((cs) => cs.featured);
const gridStudies = caseStudies.filter((cs) => !cs.featured);
---

<PageLayout
  metadata={{
    title: 'Case Studies — OWON Technology',
    description:
      'Real-world IoT deployments — see how OWON smart meters, thermostats, and sensors deliver measurable results in hotels, healthcare, energy, and manufacturing worldwide.',
  }}
>
  <section class="py-8 lg:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-4 text-sm text-muted dark:text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-default dark:text-slate-200">Case Studies</span>
      </nav>

      <!-- Hero + Stats -->
      <div class="mb-12">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-default dark:text-slate-100 mb-3">
          Proven Results. Real Deployments.
        </h1>
        <p class="text-lg text-muted dark:text-slate-400 max-w-2xl mb-8">
          OWON IoT solutions are deployed in 60+ countries. Explore how our customers
          reduce costs, improve efficiency, and scale with confidence.
        </p>

        <!-- Stats Row -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {stats.map((stat) => (
            <div class="bg-white dark:bg-slate-800 rounded-xl p-4 sm:p-5 border border-gray-200 dark:border-slate-700 text-center">
              <div class="text-2xl sm:text-3xl font-extrabold text-primary mb-1">{stat.value}</div>
              <div class="text-xs sm:text-sm text-muted dark:text-slate-400">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Industry Filter -->
      <div class="flex items-center gap-2 flex-wrap mb-8" id="industryFilters">
        <span class="text-xs font-semibold text-gray-700 dark:text-slate-300 uppercase tracking-wider mr-1">
          Industry:
        </span>
        {industries.map((ind, i) => (
          <button
            class={`filter-chip px-4 py-2 rounded-full text-sm font-semibold cursor-pointer transition-all duration-150 ${
              i === 0
                ? 'bg-primary text-primary-foreground border border-primary shadow-sm'
                : 'text-gray-600 dark:text-slate-400 bg-white dark:bg-slate-800 border-2 border-gray-300 dark:border-slate-600 hover:border-primary dark:hover:border-primary hover:text-primary'
            }`}
            data-industry={ind}
          >
            {ind}
          </button>
        ))}
      </div>

      <!-- Featured Case Study -->
      <div class="case-study-item mb-12" data-industry={featuredStudy!.industry}>
        <div class="relative bg-gradient-to-br from-primary/5 via-white to-blue-50 dark:from-primary/10 dark:via-slate-800 dark:to-slate-800/50 rounded-2xl border border-primary/20 dark:border-primary/20 overflow-hidden">
          <div class="absolute top-4 right-4 sm:top-6 sm:right-6 z-10">
            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-primary text-primary-foreground shadow-sm">
              Featured Case Study
            </span>
          </div>

          <div class="p-6 sm:p-8 lg:p-10">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="text-xs font-medium text-muted dark:text-slate-400">{featuredStudy!.region}</span>
              <span class="text-xs text-muted dark:text-slate-500">·</span>
              <span class="text-xs font-medium text-muted dark:text-slate-400">{featuredStudy!.location}</span>
            </div>

            <h2 class="text-2xl sm:text-3xl font-bold text-default dark:text-slate-100 mb-4">
              {featuredStudy!.title}
            </h2>

            <div class="grid gap-6 lg:grid-cols-2 mb-6">
              <div>
                <h3 class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Challenge</h3>
                <p class="text-sm text-muted dark:text-slate-400 leading-relaxed">{featuredStudy!.challenge}</p>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Solution</h3>
                <p class="text-sm text-muted dark:text-slate-400 leading-relaxed">{featuredStudy!.solution}</p>
              </div>
            </div>

            <!-- KPI Metrics -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
              {featuredStudy!.results.map((r) => (
                <div class="bg-white dark:bg-slate-800 rounded-xl p-4 text-center border border-gray-100 dark:border-slate-700 shadow-sm">
                  <div class="text-xl sm:text-2xl font-extrabold text-primary">{r.metric}</div>
                  <div class="text-xs text-muted dark:text-slate-500 mt-1">{r.label}</div>
                </div>
              ))}
            </div>

            <div class="flex flex-wrap items-center gap-3">
              <a
                href="/contact-sales"
                class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-primary-foreground rounded-lg font-medium hover:opacity-90 transition-opacity text-sm"
              >
                Request Full Case Study →
              </a>
              <a
                href={featuredStudy!.pdfUrl}
                download
                class="inline-flex items-center gap-2 px-5 py-2.5 border border-gray-300 dark:border-slate-600 text-default dark:text-slate-200 rounded-lg font-medium hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors text-sm"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                {featuredStudy!.pdfLabel}
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Grid Case Studies -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {gridStudies.map((cs) => (
          <div
            class="case-study-item group bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 overflow-hidden hover:shadow-lg hover:border-primary/30 dark:hover:border-primary/30 transition-all flex flex-col"
            data-industry={cs.industry}
          >
            <!-- Card Header -->
            <div class="px-5 pt-5 pb-0">
              <div class="flex items-center gap-2 mb-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary">
                  {cs.industry}
                </span>
                <span class="text-xs text-muted dark:text-slate-500">{cs.region}</span>
              </div>
              <h3 class="text-lg font-bold text-default dark:text-slate-100 mb-1 group-hover:text-primary transition-colors">
                {cs.title}
              </h3>
              <p class="text-xs text-muted dark:text-slate-500 mb-3">{cs.location}</p>
            </div>

            <!-- Challenge/Solution -->
            <div class="px-5 flex-1">
              <p class="text-sm text-muted dark:text-slate-400 leading-relaxed line-clamp-4 mb-4">
                {cs.challenge}
              </p>
            </div>

            <!-- Metrics -->
            <div class="px-5 pb-3">
              <div class="grid grid-cols-2 gap-2">
                {cs.results.map((r) => (
                  <div class="bg-gray-50 dark:bg-slate-700/50 rounded-lg p-2.5 text-center">
                    <div class="text-sm font-extrabold text-primary">{r.metric}</div>
                    <div class="text-[10px] text-muted dark:text-slate-400 leading-tight">{r.label}</div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Actions -->
            <div class="px-5 pb-5 pt-2 mt-auto border-t border-gray-100 dark:border-slate-700 flex items-center justify-between gap-2">
              <a
                href="/contact-sales"
                class="text-xs font-medium text-primary hover:underline"
              >
                Request case study →
              </a>
              <a
                href={cs.pdfUrl}
                download
                class="inline-flex items-center gap-1 text-xs text-muted dark:text-slate-400 hover:text-primary transition-colors"
                title="Download {cs.pdfLabel}"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                PDF
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- No Results -->
      <div id="noResults" class="hidden text-center py-16">
        <div class="text-4xl mb-4">🔍</div>
        <h3 class="text-lg font-semibold text-default dark:text-slate-200 mb-2">No case studies in this industry yet</h3>
        <p class="text-sm text-muted dark:text-slate-400 mb-4">We're working on it. Contact us to discuss your project.</p>
        <a href="/contact-sales" class="inline-flex items-center px-5 py-2.5 bg-primary text-primary-foreground rounded-lg font-medium hover:opacity-90 transition-opacity text-sm">
          Contact Sales →
        </a>
      </div>

      <!-- Bottom CTA -->
      <div class="mt-16 p-8 sm:p-10 bg-gradient-to-r from-primary/5 to-blue-500/5 dark:from-primary/10 dark:to-blue-500/10 rounded-2xl border border-primary/10 text-center">
        <h2 class="text-2xl font-bold mb-3 text-default dark:text-slate-100">Want to be our next case study?</h2>
        <p class="text-muted dark:text-slate-400 mb-6 max-w-lg mx-auto text-sm">
          We work closely with integrators and end-users to document successful deployments.
          Share your project goals and we'll design a solution tailored to your requirements.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href="/contact-sales"
            class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-primary-foreground rounded-lg font-medium hover:opacity-90 transition-opacity"
          >
            Start Your Project →
          </a>
          <a
            href="/resources/brochures"
            class="inline-flex items-center gap-2 px-6 py-3 border border-gray-300 dark:border-slate-600 text-default dark:text-slate-200 rounded-lg font-medium hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors"
          >
            Browse Documentation
          </a>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script is:inline>
  (function() {
    var filters = document.getElementById('industryFilters');
    if (!filters) return;

    var chips = filters.querySelectorAll('.filter-chip');
    var items = document.querySelectorAll('.case-study-item');
    var noResults = document.getElementById('noResults');

    chips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        chips.forEach(function(c) {
          c.className = c.className.replace(/bg-primary text-primary-foreground border border-primary shadow-sm/g, 'text-gray-600 dark:text-slate-400 bg-white dark:bg-slate-800 border-2 border-gray-300 dark:border-slate-600 hover:border-primary dark:hover:border-primary hover:text-primary');
        });
        this.className = 'filter-chip px-4 py-2 rounded-full text-sm font-semibold cursor-pointer transition-all duration-150 bg-primary text-primary-foreground border border-primary shadow-sm';

        var industry = this.getAttribute('data-industry');
        var anyVisible = false;

        items.forEach(function(item) {
          if (industry === 'All' || item.getAttribute('data-industry') === industry) {
            item.style.display = '';
            anyVisible = true;
          } else {
            item.style.display = 'none';
          }
        });

        if (noResults) {
          noResults.style.display = anyVisible ? 'none' : '';
        }
      });
    });
  })();
</script>
