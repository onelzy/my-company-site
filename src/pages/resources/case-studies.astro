---
import PageLayout from '~/layouts/PageLayout.astro';

const stats = [
  { value: '60+', label: 'Countries Deployed' },
  { value: '1,000+', label: 'Devices per Project' },
  { value: '100+', label: 'Service Locations (Senior Care)' },
  { value: 'Since 1993', label: 'Manufacturing Experience' },
];

const industries = [
  'All',
  'Carbon & Energy',
  'HVAC & Heating',
  'Hospitality',
  'Senior Care',
  'Telecom & Utility',
];

const caseStudies = [
  {
    id: 'hotel-room-management',
    featured: true,
    category: 'Hospitality',
    title: 'Guest Room Management System for a Chain Resort Hotel',
    client: 'A Smart Hotel System Provider',
    location: 'Global',
    challenge:
      'The client sought a wireless IoT system to replace traditional wired BMS, which is expensive and difficult to install. They needed faster deployment, lower costs, and the ability to integrate both OWON and third-party smart devices through a unified gateway with device-level MQTT API.',
    solution:
      'OWON provided a complete ZigBee 3.0 ecosystem: IoT gateway (Wi-Fi/Ethernet/4G), full MQTT device-level APIs, and a comprehensive line of hotel room devices — wall switches, relay switches, wall sockets, power meters, fan coil thermostats, curtain controllers, door/window sensors, occupancy sensors, and more. The gateway supports offline mode with local device-to-device logic, and OWON also supplied Android touchscreen control panels from its 20-year industrial tablet experience. Custom devices (DND buttons, door signage, relay switches) were developed for specific project needs.',
    results: [
      { metric: 'Wireless', label: 'No Wiring Required' },
      { metric: 'ZigBee 3.0', label: '3rd-Party Compatible' },
      { metric: 'Offline', label: 'Works Without Internet' },
      { metric: 'Full Line', label: 'All Room Devices' },
    ],
    pdfUrl: '/documents/smart-hotel-solution-brief.pdf',
    pdfLabel: 'Smart Hotel Solution Brief',
  },
  {
    id: '4g-clamp-meter-carbon',
    featured: false,
    category: 'Carbon & Energy',
    title: 'Carbon Emission Monitoring with 4G Clamp-Type Smart Meter',
    client: 'A Global Energy Management Platform Provider',
    location: 'Multi-Country',
    challenge:
      'Commissioned by national energy agencies to develop a carbon emission monitoring system for commercial incentive and penalty purposes. Required a smart meter that installs without disrupting existing billing systems, supports single/ split/ three-phase circuits from 50A to 1000A, adapts to different countries\' cellular networks, and complies with local data privacy regulations.',
    solution:
      'OWON delivered a Smart Electric Meter with open-type CTs for non-invasive installation on existing circuits. A single model supports all phase types and current ranges by simply changing CT size. The meter communicates via LTE with swappable communication modules for different countries. Device-level local APIs enable direct data forwarding to each country\'s designated cloud server, avoiding intermediate data servers for full regulatory compliance.',
    results: [
      { metric: '50A–1000A', label: 'Universal Range' },
      { metric: '4G/Cat1/CatM', label: 'Multi-Network' },
      { metric: 'Non-Invasive', label: 'Quick Install' },
      { metric: 'Local API', label: 'Data Sovereignty' },
    ],
    pdfUrl: '/documents/industrial-iot-datasheet.pdf',
    pdfLabel: 'Industrial IoT Datasheet',
  },
  {
    id: 'hybrid-thermostat',
    featured: false,
    category: 'HVAC & Heating',
    title: 'Custom Dual Fuel Thermostat for Heat Pump + Furnace Systems',
    client: 'A North American Furnace & Heat Pump Manufacturer',
    location: 'North America',
    challenge:
      'Heat pump adoption has grown rapidly, but many households retain conventional heating/cooling equipment. The manufacturer needed a thermostat that controls both systems simultaneously and intelligently switches between them for optimal cost-effectiveness. Additional requirements: outdoor temperature acquisition, compatibility with the manufacturer\'s proprietary Wi-Fi module and backend server, and the ability to control humidifiers/dehumidifiers.',
    solution:
      'OWON customized an existing thermostat model: rewrote firmware for the manufacturer\'s dual-fuel switching logic, integrated outdoor temperature from both online weather data and a wireless outdoor sensor, replaced the communication module with the client\'s designated Wi-Fi module (MQTT protocol), and added extra relays and connection terminals for humidifier and dehumidifier control.',
    results: [
      { metric: 'Dual Fuel', label: 'Heat Pump + Furnace' },
      { metric: 'Custom FW', label: 'Bespoke Control Logic' },
      { metric: 'MQTT', label: 'Client Server Compatible' },
      { metric: 'Extra Relays', label: 'Humidity Control' },
    ],
    pdfUrl: '/documents/pct513-thermostat.pdf',
    pdfLabel: 'PCT513 Thermostat Datasheet',
  },
  {
    id: 'residential-heating-eu',
    featured: false,
    category: 'HVAC & Heating',
    title: 'Government-Driven Residential Heating Energy Saving System',
    client: 'A European System Integrator',
    location: 'Europe',
    challenge:
      'A government initiative to reduce residential heating energy consumption required a system that manages all mainstream European heating equipment: boilers, heat pumps, hot water, hydraulic/electrical radiators, and underfloor heating. Critical requirements: full offline operation without internet dependency, mobile app control even without a Wi-Fi router (AP mode), and complete device-level local APIs for custom cloud and mobile app development.',
    solution:
      'OWON provided a full ZigBee ecosystem centered on an Edge Gateway: PCT512 to control boilers/heat pumps, TRV517 for hydraulic radiators, PIR323 + SLC621 for electric heater control, and THS317-ET + SLC651 for underfloor heating. The gateway supports three modes — Local (same Wi-Fi), Internet (remote cloud), and AP (direct hotspot). OWON TCP/IP API and MQTT API are provided for system integration.',
    results: [
      { metric: '3 Modes', label: 'Local / Internet / AP' },
      { metric: 'Offline', label: 'No Internet Required' },
      { metric: 'Full API', label: 'TCP/IP + MQTT' },
      { metric: 'All Equipment', label: 'Boiler to Underfloor' },
    ],
    pdfUrl: '/documents/boiler-trv-solutions.pdf',
    pdfLabel: 'Boiler & TRV Solution Brief',
  },
  {
    id: 'home-energy-telecom',
    featured: false,
    category: 'Telecom & Utility',
    title: 'Utility-Driven Home Energy Management for Millions of Homes',
    client: 'A European Telecommunication Company',
    location: 'Europe',
    challenge:
      'The telecom operator planned a Home Energy Management System (HEMS) for mass deployment to millions of homes. Requirements: monitor and control overall energy consumption, solar generation, and EV chargers; control and schedule HVAC equipment (boilers, heat pumps, mini-split A/C); enable device-to-device interactions (e.g., turn off A/C when window opens, adjust EV charging based on solar surplus); and provide device-level local APIs for direct integration with the Telco\'s cloud.',
    solution:
      'OWON delivered a complete ZigBee device suite: clamp power meters, Din rail relays, and smart plugs for energy monitoring; thermostats and IR blasters for HVAC control; plus a Smart ZigBee Hub with local networking capabilities for device-to-device interaction logic. The hub\'s complete local API allows direct connection to the Telco\'s backend server with no intermediate cloud dependency.',
    results: [
      { metric: 'Millions', label: 'Target Deployment' },
      { metric: 'ZigBee Hub', label: 'Local Intelligence' },
      { metric: 'EV + Solar', label: 'Full Home Energy' },
      { metric: 'Direct API', label: 'No Cloud Middleman' },
    ],
    pdfUrl: '/documents/single-phase-meter-series.pdf',
    pdfLabel: 'Smart Meter Series Datasheet',
  },
  {
    id: 'senior-care-platform',
    featured: false,
    category: 'Senior Care',
    title: '三位一体智慧养老平台 — 居家·社区·机构一体化管理',
    client: '湖北某综合养老服务公司（文旅集团下属国企）',
    location: '湖北 · 中国',
    challenge:
      '该企业以武汉为核心覆盖湖北多市，运营近100个为老服务网点，承接家庭养老床位超1000张，累计服务超100万人次，月均上门超5万次。需要一个统一平台管理居家、社区、食堂三个独立场景，提供家属端App、服务端管理后台、食堂菜品销售统计与热销排行，以及机构床位管理功能，并能生成长者行为摘要辅助照护决策。',
    solution:
      '部署4G门磁、红外、烟感、水浸等安防设备，无需网关数据直传云端。长者活动数据接入爱居安平台自动生成行为摘要。家属端使用亲属App（爱居安·家），社区端使用Web集中看护平台。食堂管理模块支持菜品统计、菜谱管理、热销排行。平台内置机构床位管理，支持床位分配与入住管理。',
    results: [
      { metric: '100+', label: '服务网点覆盖' },
      { metric: '1,000+', label: '家庭养老床位' },
      { metric: '100万+', label: '累计服务人次' },
      { metric: '三场景', label: '居家·社区·机构' },
    ],
    pdfUrl: '/documents/senior-care-solution-overview.pdf',
    pdfLabel: 'Senior Care Solution Overview',
  },
  {
    id: 'senior-care-nursing-home',
    featured: false,
    category: 'Senior Care',
    title: '五星级养老护理院 · 爱居安无线监护系统部署',
    client: '福建某五星级养老护理院',
    location: '福建 · 中国',
    challenge:
      '项目分为新楼智能病房建设（16层，1.8万㎡，380张床位）与旧楼智能化改造（200张床位）。需覆盖老人监护、环境监测、能源管理、温度控制等功能。设备必须无线、电池供电、免打孔安装以免中断正常运营；软件须模块化配置无需定制开发；数据须本地服务器部署保障隐私和断网可用。',
    solution:
      '采用爱居安系统方案（ZigBee无线设备 + 可配置软件平台），部署网关、门磁、红外、烟感、水浸、温湿度传感器、睡眠监测带、跌倒雷达、温控器等近千个设备。电池供电、背胶安装，非专业人员即可部署。软件模块化勾选配置，按需启用各功能模块。本地服务器部署，数据不出院，断网正常运行。两期项目均仅数周完成交付。',
    results: [
      { metric: '近千台', label: '智能设备部署' },
      { metric: '580张', label: '护理床位覆盖' },
      { metric: '数周', label: '完成两期交付' },
      { metric: '本地部署', label: '数据不出院' },
    ],
    pdfUrl: '/documents/senior-care-solution-overview.pdf',
    pdfLabel: 'Senior Care Solution Overview',
  },
  {
    id: 'senior-care-api-integration',
    featured: false,
    category: 'Senior Care',
    title: '养老软件集成商 · 平台API对接与AI能力赋能',
    client: '某省养老信息化软件开发商',
    location: '中国',
    challenge:
      '该公司深耕养老行业多年，机构管理系统已在省内多地市广泛应用，服务数十家养老机构及社区网点。但其平台缺少物联网设备接入能力及AI行为分析模块，无法满足长者安全看护、行为报告、主动预警等智能化需求。面对养老服务升级，亟需快速补齐物联与AI短板以提升竞争力，且开发周期须短以尽快用于项目投标。',
    solution:
      'OWON提供硬件设备API：4G单品和ZigBee网关原生支持MQTT/HTTP协议，客户平台直接订阅设备数据。AI能力调用：OWON提供行为分析API与健康预警API，客户平台HTTP调用获取行为报告。私有化部署：中标后将爱居安平台（含AI引擎）部署在客户自有服务器，完全自主可控。',
    results: [
      { metric: 'MQTT/HTTP', label: '原生协议对接' },
      { metric: 'AI API', label: '行为分析+健康预警' },
      { metric: '短周期', label: '快速投标交付' },
      { metric: '私有部署', label: '数据自主可控' },
    ],
    pdfUrl: '/documents/senior-care-solution-overview.pdf',
    pdfLabel: 'Senior Care Solution Overview',
  },
];

const featuredStudy = caseStudies.find((cs) => cs.featured)!;
const gridStudies = caseStudies.filter((cs) => !cs.featured);
---

<PageLayout
  metadata={{
    title: 'Customer Case Studies — OWON Technology',
    description:
      'Real-world deployments: smart meters for carbon monitoring, hotel room management, dual-fuel HVAC, government heating systems, telecom HEMS, and senior care IoT — all backed by verifiable client projects.',
  }}
>
  <section class="py-8 lg:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-4 text-sm text-muted dark:text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-default dark:text-slate-200">Case Studies</span>
      </nav>

      <!-- Hero + Stats -->
      <div class="mb-12">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-default dark:text-slate-100 mb-3">
          Proven Results. Real Deployments.
        </h1>
        <p class="text-lg text-muted dark:text-slate-400 max-w-3xl mb-8">
          Every case study on this page is based on actual OWON customer projects
          documented in our product catalogs and solution brochures. No fabricated data.
        </p>

        <!-- Stats Row -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {stats.map((stat) => (
            <div class="bg-white dark:bg-slate-800 rounded-xl p-4 sm:p-5 border border-gray-200 dark:border-slate-700 text-center">
              <div class="text-2xl sm:text-3xl font-extrabold text-primary mb-1">{stat.value}</div>
              <div class="text-xs sm:text-sm text-muted dark:text-slate-400">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Industry Filter -->
      <div class="flex items-center gap-2 flex-wrap mb-8" id="industryFilters">
        <span class="text-xs font-semibold text-gray-700 dark:text-slate-300 uppercase tracking-wider mr-1">
          Category:
        </span>
        {industries.map((ind, i) => (
          <button
            class={`filter-chip px-4 py-2 rounded-full text-sm font-semibold cursor-pointer transition-all duration-150 ${
              i === 0
                ? 'bg-primary text-primary-foreground border border-primary shadow-sm'
                : 'text-gray-600 dark:text-slate-400 bg-white dark:bg-slate-800 border-2 border-gray-300 dark:border-slate-600 hover:border-primary dark:hover:border-primary hover:text-primary'
            }`}
            data-category={ind}
          >
            {ind}
          </button>
        ))}
      </div>

      <!-- Featured Case Study -->
      <div class="case-study-item mb-12" data-category={featuredStudy.category}>
        <div class="relative bg-gradient-to-br from-primary/5 via-white to-blue-50 dark:from-primary/10 dark:via-slate-800 dark:to-slate-800/50 rounded-2xl border border-primary/20 dark:border-primary/20 overflow-hidden">
          <div class="absolute top-4 right-4 sm:top-6 sm:right-6 z-10">
            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-primary text-primary-foreground shadow-sm">
              Featured Case Study
            </span>
          </div>

          <div class="p-6 sm:p-8 lg:p-10">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary">
                {featuredStudy.category}
              </span>
              <span class="text-xs text-muted dark:text-slate-400">{featuredStudy.client}</span>
            </div>

            <h2 class="text-2xl sm:text-3xl font-bold text-default dark:text-slate-100 mb-4">
              {featuredStudy.title}
            </h2>

            <div class="grid gap-6 lg:grid-cols-2 mb-6">
              <div>
                <h3 class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Requirement</h3>
                <p class="text-sm text-muted dark:text-slate-400 leading-relaxed">{featuredStudy.challenge}</p>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-primary uppercase tracking-wide mb-2">Solution</h3>
                <p class="text-sm text-muted dark:text-slate-400 leading-relaxed">{featuredStudy.solution}</p>
              </div>
            </div>

            <!-- KPI Metrics -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
              {featuredStudy.results.map((r) => (
                <div class="bg-white dark:bg-slate-800 rounded-xl p-4 text-center border border-gray-100 dark:border-slate-700 shadow-sm">
                  <div class="text-xl sm:text-2xl font-extrabold text-primary">{r.metric}</div>
                  <div class="text-xs text-muted dark:text-slate-500 mt-1">{r.label}</div>
                </div>
              ))}
            </div>

            <div class="flex flex-wrap items-center gap-3">
              <a
                href="/contact-sales"
                class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary text-primary-foreground rounded-lg font-medium hover:opacity-90 transition-opacity text-sm"
              >
                Request Full Case Study →
              </a>
              <a
                href={featuredStudy.pdfUrl}
                download
                class="inline-flex items-center gap-2 px-5 py-2.5 border border-gray-300 dark:border-slate-600 text-default dark:text-slate-200 rounded-lg font-medium hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors text-sm"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                {featuredStudy.pdfLabel}
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Grid Case Studies -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {gridStudies.map((cs) => (
          <div
            class="case-study-item group bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 overflow-hidden hover:shadow-lg hover:border-primary/30 dark:hover:border-primary/30 transition-all flex flex-col"
            data-category={cs.category}
          >
            <!-- Card Header -->
            <div class="px-5 pt-5 pb-0">
              <div class="flex items-center gap-2 mb-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary">
                  {cs.category}
                </span>
              </div>
              <h3 class="text-base font-bold text-default dark:text-slate-100 mb-1 group-hover:text-primary transition-colors leading-snug">
                {cs.title}
              </h3>
              <p class="text-xs text-muted dark:text-slate-500 mb-3">{cs.client} · {cs.location}</p>
            </div>

            <!-- Challenge + Solution -->
            <div class="px-5 flex-1">
              <p class="text-sm text-muted dark:text-slate-400 leading-relaxed line-clamp-4 mb-4">
                {cs.challenge}
              </p>
            </div>

            <!-- Metrics -->
            <div class="px-5 pb-3">
              <div class="grid grid-cols-2 gap-2">
                {cs.results.map((r) => (
                  <div class="bg-gray-50 dark:bg-slate-700/50 rounded-lg p-2.5 text-center">
                    <div class="text-sm font-extrabold text-primary">{r.metric}</div>
                    <div class="text-[10px] text-muted dark:text-slate-400 leading-tight">{r.label}</div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Actions -->
            <div class="px-5 pb-5 pt-2 mt-auto border-t border-gray-100 dark:border-slate-700 flex items-center justify-between gap-2">
              <a
                href="/contact-sales"
                class="text-xs font-medium text-primary hover:underline"
              >
                Request full case study →
              </a>
              <a
                href={cs.pdfUrl}
                download
                class="inline-flex items-center gap-1 text-xs text-muted dark:text-slate-400 hover:text-primary transition-colors"
                title={`Download ${cs.pdfLabel}`}
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
                PDF
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- No Results -->
      <div id="noResults" class="hidden text-center py-16">
        <div class="text-4xl mb-4">🔍</div>
        <h3 class="text-lg font-semibold text-default dark:text-slate-200 mb-2">No case studies in this category yet</h3>
        <p class="text-sm text-muted dark:text-slate-400 mb-4">Contact us to discuss your project — you could be our next case study.</p>
        <a href="/contact-sales" class="inline-flex items-center px-5 py-2.5 bg-primary text-primary-foreground rounded-lg font-medium hover:opacity-90 transition-opacity text-sm">
          Contact Sales →
        </a>
      </div>

      <!-- Bottom CTA -->
      <div class="mt-16 p-8 sm:p-10 bg-gradient-to-r from-primary/5 to-blue-500/5 dark:from-primary/10 dark:to-blue-500/10 rounded-2xl border border-primary/10 text-center">
        <h2 class="text-2xl font-bold mb-3 text-default dark:text-slate-100">Want to be our next case study?</h2>
        <p class="text-muted dark:text-slate-400 mb-6 max-w-lg mx-auto text-sm">
          We work closely with integrators and end-users to document successful deployments.
          Share your project goals and we'll design a solution tailored to your requirements.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href="/contact-sales"
            class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-primary-foreground rounded-lg font-medium hover:opacity-90 transition-opacity"
          >
            Start Your Project →
          </a>
          <a
            href="/resources/brochures"
            class="inline-flex items-center gap-2 px-6 py-3 border border-gray-300 dark:border-slate-600 text-default dark:text-slate-200 rounded-lg font-medium hover:bg-gray-50 dark:hover:bg-slate-800 transition-colors"
          >
            Browse Documentation
          </a>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script is:inline>
  (function() {
    var filters = document.getElementById('industryFilters');
    if (!filters) return;

    var chips = filters.querySelectorAll('.filter-chip');
    var items = document.querySelectorAll('.case-study-item');
    var noResults = document.getElementById('noResults');

    chips.forEach(function(chip) {
      chip.addEventListener('click', function() {
        chips.forEach(function(c) {
          c.className = c.className.replace(/bg-primary text-primary-foreground border border-primary shadow-sm/g, 'text-gray-600 dark:text-slate-400 bg-white dark:bg-slate-800 border-2 border-gray-300 dark:border-slate-600 hover:border-primary dark:hover:border-primary hover:text-primary');
        });
        this.className = 'filter-chip px-4 py-2 rounded-full text-sm font-semibold cursor-pointer transition-all duration-150 bg-primary text-primary-foreground border border-primary shadow-sm';

        var category = this.getAttribute('data-category');
        var anyVisible = false;

        items.forEach(function(item) {
          if (category === 'All' || item.getAttribute('data-category') === category) {
            item.style.display = '';
            anyVisible = true;
          } else {
            item.style.display = 'none';
          }
        });

        if (noResults) {
          noResults.style.display = anyVisible ? 'none' : '';
        }
      });
    });
  })();
</script>
