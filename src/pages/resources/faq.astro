---
import PageLayout from '~/layouts/PageLayout.astro';

// Static page: build-time render → CDN-cached.
export const prerender = true;

const faqCategories = [
  {
    category: 'Products & Specifications',
    items: [
      {
        q: 'What communication protocols do OWON devices support?',
        a: 'OWON devices support ZigBee 3.0, Wi-Fi (2.4 GHz), Modbus RTU/TCP, MQTT, and TCP/IP. Protocol support varies by model — check individual product pages for details.',
      },
      {
        q: 'What is the accuracy class of OWON smart meters?',
        a: 'OWON single-phase meters are typically Class 1.0 (IEC 62053-21) and three-phase meters are Class 0.5S or 1.0. All meters are CE and MID certified.',
      },
      {
        q: 'Can I use OWON devices with my existing ZigBee gateway?',
        a: 'Yes — OWON ZigBee 3.0 devices are interoperable with standard ZigBee 3.0 coordinators. We also provide our own OWON gateway for turnkey deployments.',
      },
      {
        q: 'What is the warranty period?',
        a: 'All OWON products come with a 2-year standard warranty. Extended warranties are available for volume orders — contact sales for details.',
      },
    ],
  },
  {
    category: 'Installation & Setup',
    items: [
      {
        q: 'Do I need a certified electrician to install smart meters?',
        a: 'Yes — smart meters connect to mains wiring and must be installed by a certified electrician. DIN rail mounting is standard; detailed wiring diagrams are included in the product manual.',
      },
      {
        q: 'How do I pair devices with the OWON gateway?',
        a: 'Put the gateway in pairing mode via the web interface or mobile app, then power on the device. Most devices auto-join within 30 seconds. Refer to the Quick Start Guide in the box.',
      },
      {
        q: 'What WiFi bands are supported?',
        a: 'OWON WiFi devices operate on 2.4 GHz (802.11 b/g/n). 5 GHz is not supported to maintain better range and wall penetration.',
      },
      {
        q: 'How far can ZigBee devices be from the gateway?',
        a: 'Typical indoor range is 30–50 meters (line of sight up to 100m). ZigBee mesh networking extends range — each mains-powered device acts as a repeater.',
      },
    ],
  },
  {
    category: 'API & Integration',
    items: [
      {
        q: 'Is there a public API for system integration?',
        a: 'Yes — OWON provides MQTT and REST APIs for third-party integration. Full documentation is available in the Developers section, including code examples and SDKs.',
      },
      {
        q: 'Can I integrate OWON devices with Home Assistant?',
        a: 'Yes — OWON devices are compatible with Home Assistant via MQTT auto-discovery or the native ZigBee integration (ZHA / Zigbee2MQTT).',
      },
      {
        q: 'How do I pull energy data into my own dashboard?',
        a: 'Use the MQTT API to subscribe to device telemetry topics. Data is published in JSON format at configurable intervals. See /developers/mqtt for topic structure and examples.',
      },
      {
        q: 'Do you support Modbus integration for industrial systems?',
        a: 'Yes — selected meter models have RS-485 Modbus RTU interfaces. Modbus register maps are available in the product datasheets.',
      },
    ],
  },
  {
    category: 'Ordering & OEM',
    items: [
      {
        q: 'How do I get pricing and place an order?',
        a: 'OWON sells B2B through distributors and direct sales. Use the Get Base Price button on any product page, or contact our sales team for volume pricing and lead times.',
      },
      {
        q: 'What is the minimum order quantity (MOQ)?',
        a: 'MOQ varies by product — typically 10–50 units for standard products. OEM/ODM projects have higher MOQs. Contact sales for your specific requirements.',
      },
      {
        q: 'Do you offer OEM/ODM branding?',
        a: 'Yes — we offer custom branding (logo, color, packaging), firmware customization, and private-label options. MOQ and lead time depend on the scope of customization.',
      },
      {
        q: 'What certifications do OWON products have?',
        a: 'OWON products carry CE, UKCA, FCC, and MID certifications. Specific certificates are available on request. Our factory is ISO 9001 certified.',
      },
    ],
  },
  {
    category: 'Troubleshooting',
    items: [
      {
        q: 'Device is offline — what should I check?',
        a: 'Check (1) power supply, (2) gateway online status, (3) ZigBee/WiFi signal strength, (4) network firewall settings. Most offline issues are resolved by power-cycling the device and gateway.',
      },
      {
        q: 'Energy readings seem inaccurate — how to verify?',
        a: 'Compare against a calibrated reference meter. Ensure CT clamps (if applicable) are correctly oriented and fully closed. Contact support if deviation exceeds the rated accuracy class.',
      },
      {
        q: 'Firmware update failed — how to recover?',
        a: 'Do not power off the device during update. If the update fails, the device enters safe mode — retry the OTA update from the gateway. Contact support if the issue persists.',
      },
    ],
  },
];

const totalFAQs = faqCategories.reduce((sum, cat) => sum + cat.items.length, 0);
---

<PageLayout
  metadata={{
    title: 'FAQ',
    description:
      'Frequently asked questions about OWON smart meters, thermostats, IoT solutions, API integration, installation, ordering, and OEM services.',
  }}
>
  <section class="py-8 lg:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-4 text-sm text-muted dark:text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-default dark:text-slate-200">FAQ</span>
      </nav>

      <!-- Dimension Tabs -->
      <div class="flex gap-1 p-1 bg-gray-100 dark:bg-slate-800 rounded-xl mb-8 w-fit">
        <a
          href="/resources/documentation"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-gray-600 dark:text-slate-400 hover:bg-white/60 dark:hover:bg-slate-700/60"
          >Documentation</a
        >
        <a
          href="/resources/videos"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-gray-600 dark:text-slate-400 hover:bg-white/60 dark:hover:bg-slate-700/60"
          >Videos</a
        >
        <a
          href="/resources/app"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-gray-600 dark:text-slate-400 hover:bg-white/60 dark:hover:bg-slate-700/60"
          >App Downloads</a
        >
        <a
          href="/resources/faq"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 bg-white dark:bg-slate-700 text-default dark:text-slate-200 shadow-sm"
          >FAQ</a
        >
      </div>

      <!-- Search -->
      <div class="bg-white dark:bg-slate-800/50 rounded-xl p-4 mb-6 border border-gray-200 dark:border-slate-700 shadow-sm">
        <div class="relative max-w-md">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg
            >
          </span>
          <input
            type="text"
            id="faqSearch"
            placeholder="Search {totalFAQs} FAQs by keyword..."
            class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-default dark:text-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-shadow"
          />
        </div>
      </div>

      <!-- FAQ Sections -->
      <div id="faqList" class="space-y-10">
        {faqCategories.map((cat) => (
          <div class="faq-section">
            <h2 class="text-xl font-bold text-default dark:text-slate-100 mb-4 pb-2 border-b border-gray-200 dark:border-slate-700">
              {cat.category}
            </h2>
            <div class="space-y-3">
              {cat.items.map((item) => (
                <details class="faq-item group bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 hover:border-primary/30 dark:hover:border-primary/30 transition-colors">
                  <summary class="px-5 py-4 cursor-pointer font-medium text-default dark:text-slate-200 text-sm list-none flex justify-between items-center">
                    {item.q}
                    <svg class="w-4 h-4 text-muted dark:text-slate-500 group-open:rotate-180 transition-transform shrink-0 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                  </summary>
                  <p class="px-5 pb-4 text-sm text-muted dark:text-slate-400 leading-relaxed">{item.a}</p>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- No Results -->
      <div id="faqNoResults" class="hidden text-center py-12">
        <div class="text-4xl mb-4">🔍</div>
        <h3 class="text-lg font-semibold text-default dark:text-slate-200 mb-2">No matching FAQs</h3>
        <p class="text-sm text-muted dark:text-slate-400 mb-4">Try a different search term, or contact us directly.</p>
        <a href="/contact-sales" class="inline-flex items-center px-5 py-2.5 bg-primary text-primary-foreground rounded-lg font-medium hover:opacity-90 transition-opacity text-sm">
          Contact Sales →
        </a>
      </div>

      <!-- CTA -->
      <div class="mt-12 p-8 bg-primary/5 dark:bg-primary/10 rounded-2xl border border-primary/10 text-center">
        <h2 class="text-xl font-bold mb-2 text-default dark:text-slate-100">Didn't find your answer?</h2>
        <p class="text-muted dark:text-slate-400 mb-4 text-sm">
          Our support team is ready to help with technical questions, integration support, and product inquiries.
        </p>
        <a
          href="/contact-sales"
          class="inline-flex items-center gap-2 px-6 py-2.5 bg-primary text-primary-foreground rounded-lg font-medium hover:opacity-90 transition-opacity text-sm"
        >
          Contact Our Team →
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<script is:inline>
  (function() {
    var search = document.getElementById('faqSearch');
    if (!search) return;
    var searchTimer;
    search.addEventListener('input', function() {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(function() {
        var term = search.value.toLowerCase().trim();
        var sections = document.querySelectorAll('.faq-section');
        var items = document.querySelectorAll('.faq-item');
        var noResults = document.getElementById('faqNoResults');
        var anyVisible = false;

        items.forEach(function(item) {
          var text = item.textContent.toLowerCase();
          if (!term || text.indexOf(term) !== -1) {
            item.style.display = '';
            anyVisible = true;
          } else {
            item.style.display = 'none';
          }
        });

        // Show/hide section headers based on visible items
        sections.forEach(function(section) {
          var visibleItems = section.querySelectorAll('.faq-item[style*="display: none"]');
          if (section.querySelectorAll('.faq-item').length === visibleItems.length) {
            section.style.display = 'none';
          } else {
            section.style.display = '';
          }
        });

        if (noResults) {
          noResults.style.display = anyVisible ? 'none' : '';
        }
      }, 300);
    });
  })();
</script>
