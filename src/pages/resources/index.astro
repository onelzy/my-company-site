---
import PageLayout from '~/layouts/PageLayout.astro';

const faqItems = [
  {
    category: 'Installation',
    items: [
      { q: 'How do I install the smart meter?', a: 'DIN rail mount. Follow the wiring diagram included in the box.' },
      { q: 'Do I need an electrician?', a: 'Yes — installation requires a certified electrician for mains wiring.' },
    ],
  },
  {
    category: 'Connectivity',
    items: [
      { q: 'Does it work without internet?', a: 'Yes — local ZigBee and Modbus communication works without internet.' },
      { q: 'Which protocols are supported?', a: 'ZigBee 3.0, Wi-Fi, Modbus RTU/TCP, MQTT, and TCP/IP.' },
    ],
  },
  {
    category: 'API & Integration',
    items: [
      { q: 'Is there a public API?', a: 'Yes — MQTT and REST API. Documentation at /developers/api.' },
      { q: 'Can I integrate with Home Assistant?', a: 'Yes — OWON devices support local API for Home Assistant.' },
    ],
  },
  {
    category: 'Billing & Order',
    items: [
      { q: 'How do I get pricing?', a: 'Use the Get Base Price button on any product, or contact sales.' },
      { q: 'Do you offer OEM/ODM?', a: 'Yes — contact sales for customization, MOQ, and lead times.' },
    ],
  },
];
---

<PageLayout
  metadata={{
    title: 'Resources — OWON Technology',
    description: 'Product brochures, FAQ, video demos, app downloads, and case studies for OWON IoT solutions.',
  }}
>
  <!-- ===== Hero ===== -->
  <section class="bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl font-extrabold mb-4">Resource Center</h1>
      <p class="text-lg text-slate-300 max-w-xl mx-auto">
        Everything you need to evaluate, integrate, and deploy OWON IoT solutions.
      </p>
    </div>
  </section>

  <!-- ===== Resource Cards ===== -->
  <section class="py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href="/resources/brochures" class="group bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-slate-700 hover:shadow-md hover:border-blue-300 dark:hover:border-blue-700 transition-all">
          <div class="text-3xl mb-3">📖</div>
          <h3 class="text-lg font-semibold text-default dark:text-slate-100 mb-1 group-hover:text-blue-600 transition-colors">Brochures</h3>
          <p class="text-sm text-muted">Product catalogs, datasheets, and company profile PDFs for download.</p>
        </a>
        <a href="/resources/videos" class="group bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-slate-700 hover:shadow-md hover:border-blue-300 dark:hover:border-blue-700 transition-all">
          <div class="text-3xl mb-3">🎬</div>
          <h3 class="text-lg font-semibold text-default dark:text-slate-100 mb-1 group-hover:text-blue-600 transition-colors">Videos</h3>
          <p class="text-sm text-muted">Product demos, installation guides, and customer case study videos.</p>
        </a>
        <a href="/resources/app" class="group bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-slate-700 hover:shadow-md hover:border-blue-300 dark:hover:border-blue-700 transition-all">
          <div class="text-3xl mb-3">📱</div>
          <h3 class="text-lg font-semibold text-default dark:text-slate-100 mb-1 group-hover:text-blue-600 transition-colors">App Downloads</h3>
          <p class="text-sm text-muted">Mobile apps for device configuration, energy monitoring, and debugging.</p>
        </a>
        <a href="/blog" class="group bg-white dark:bg-slate-800 rounded-xl p-6 shadow-sm border border-gray-100 dark:border-slate-700 hover:shadow-md hover:border-blue-300 dark:hover:border-blue-700 transition-all">
          <div class="text-3xl mb-3">📝</div>
          <h3 class="text-lg font-semibold text-default dark:text-slate-100 mb-1 group-hover:text-blue-600 transition-colors">Case Studies</h3>
          <p class="text-sm text-muted">Real-world deployments — hotels, factories, and senior care facilities.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== FAQ Section ===== -->
  <section class="py-12 lg:py-16 bg-gray-50 dark:bg-slate-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-default dark:text-slate-100 mb-2">Frequently Asked Questions</h2>
        <p class="text-muted">Quick answers to common questions about OWON products and services.</p>
      </div>

      <div class="space-y-6">
        {faqItems.map((cat) => (
          <div>
            <h3 class="text-lg font-semibold text-default dark:text-slate-200 mb-3 border-b border-gray-200 dark:border-slate-700 pb-2">{cat.category}</h3>
            <div class="space-y-3">
              {cat.items.map((item) => (
                <details class="group bg-white dark:bg-slate-800 rounded-lg border border-gray-100 dark:border-slate-700">
                  <summary class="px-5 py-3.5 cursor-pointer font-medium text-default dark:text-slate-200 text-sm list-none flex justify-between items-center">
                    {item.q}
                    <svg class="w-4 h-4 text-muted group-open:rotate-180 transition-transform shrink-0 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                  </summary>
                  <p class="px-5 pb-4 text-sm text-muted leading-relaxed">{item.a}</p>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="py-12">
    <div class="max-w-xl mx-auto px-4 text-center">
      <p class="text-muted mb-4">Can't find what you're looking for?</p>
      <a href="/contact-sales" class="inline-flex items-center px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-semibold transition-colors">
        Contact Our Team →
      </a>
    </div>
  </section>
</PageLayout>
