---
import PageLayout from '~/layouts/PageLayout.astro';
import VideoPlayer from '~/components/common/VideoPlayer.astro';
import { Icon } from 'astro-icon/components';

// Static page: build-time render → CDN-cached.
export const prerender = true;

const R2 = 'https://documents.owon-iot.com/videos';
---

<PageLayout
  metadata={{
    title: 'Video Center — OWON Company & Product Videos',
    description:
      'Watch the OWON company film and product demonstration videos: smart energy meters, zigbee thermostats, gateways, and industry solutions for hotels and senior care.',
    ogImage: `https://www.owon-iot.com/about-owon-poster.jpg`,
  }}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name: 'OWON — Smart Energy & IoT Devices Company Film',
      description:
        'A five-minute tour of Xiamen OWON: company overview, smart energy meters, zigbee thermostats, IoT gateways, hotel and senior-care solutions, R&D and manufacturing.',
      thumbnailUrl: `https://www.owon-iot.com/about-owon-poster.jpg`,
      uploadDate: '2026-08-31',
      duration: 'PT5M19S',
      contentUrl: `${R2}/about-owon.mp4`,
      embedUrl: 'https://www.owon-iot.com/resources/videos/',
    })}
  />

  <section class="py-8 lg:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-4 text-sm text-muted dark:text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-default dark:text-slate-200">Videos</span>
      </nav>

      <!-- Dimension Tabs -->
      <div class="flex gap-1 p-1 bg-gray-100 dark:bg-slate-800 rounded-xl mb-8 w-fit">
        <a
          href="/resources/documentation"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-gray-600 dark:text-slate-400 hover:bg-white/60 dark:hover:bg-slate-700/60"
        >
          Documentation</a
        >
        <a
          href="/resources/videos"
          aria-current="page"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 bg-white dark:bg-slate-700 text-default dark:text-slate-200 shadow-sm"
        >
          Videos</a
        >
        <a
          href="/resources/app"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-gray-600 dark:text-slate-400 hover:bg-white/60 dark:hover:bg-slate-700/60"
        >
          App Downloads</a
        >
        <a
          href="/resources/faq"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-gray-600 dark:text-slate-400 hover:bg-white/60 dark:hover:bg-slate-700/60"
          >FAQ</a
        >
      </div>

      <!-- Page heading -->
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-default dark:text-slate-100">Video Center</h1>
        <p class="text-muted dark:text-slate-400 mt-2 max-w-2xl">
          Get to know OWON in five minutes — factory, products, and the people behind 400+ device models.
        </p>
      </div>

      <!-- Featured: company film -->
      <div class="mb-12 max-w-4xl">
        <VideoPlayer
          src={`${R2}/about-owon.mp4`}
          poster={`https://www.owon-iot.com/about-owon-poster.jpg`}
          title="OWON Company Film"
          description="Xiamen OWON at a glance: smart energy meters, zigbee thermostats and room control, IoT gateways, hotel and senior-care solutions, R&D, SMT manufacturing and assembly."
          tracks={[
            { src: `https://www.owon-iot.com/about-owon-en.vtt`, srclang: 'en', label: 'English', default: true },
          ]}
        />
      </div>

      <!-- On-request video categories -->
      <h2 class="text-xl font-bold text-default dark:text-slate-100 mb-4">Product videos — on request</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-10">
        {
          [
            {
              icon: 'tabler:gauge',
              title: 'Smart Energy Meters',
              desc: 'Single-phase and three-phase meter unboxing, wiring, DIN-rail installation, and live readings walkthrough.',
            },
            {
              icon: 'tabler:temperature',
              title: 'Thermostats & HVAC Control',
              desc: 'TRV and wall thermostat setup, weekly scheduling, and controller pairing demos.',
            },
            {
              icon: 'tabler:router',
              title: 'Gateways & Integration',
              desc: 'Gateway provisioning and a hands-on look at the MQTT integration debugger in action.',
            },
            {
              icon: 'tabler:building-community',
              title: 'Industry Solutions',
              desc: 'Hotel room control and senior-care monitoring solution overviews for facility teams.',
            },
          ].map((item) => (
            <div class="p-5 rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800">
              <Icon name={item.icon} class="w-7 h-7 mb-3 text-primary" />
              <h3 class="font-semibold text-default dark:text-slate-200 mb-1">{item.title}</h3>
              <p class="text-sm text-muted dark:text-slate-400">{item.desc}</p>
            </div>
          ))
        }
      </div>

      <!-- CTA: request videos -->
      <div class="rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800/50 p-6">
        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
          <Icon name="tabler:video" class="w-8 h-8 text-primary shrink-0" />
          <div class="flex-1">
            <h2 class="font-bold text-default dark:text-slate-200 mb-1">Need a demo video for a specific device?</h2>
            <p class="text-sm text-muted dark:text-slate-400">
              Our video library is being published in batches. Tell us which product or integration you are evaluating
              and we will send the matching footage — usually within one business day.
            </p>
          </div>
          <a
            href="/contact"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold text-white bg-primary hover:opacity-90 transition-opacity shrink-0"
          >
            <Icon name="tabler:mail" class="w-4 h-4" /> Request a Video</a
          >
        </div>
      </div>
    </div>
  </section>
</PageLayout>
