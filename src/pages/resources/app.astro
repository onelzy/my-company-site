---
import PageLayout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

// Static page: build-time render → CDN-cached.
export const prerender = true;
---

<PageLayout
  metadata={{
    title: 'App Downloads',
    description:
      'Download OWON mobile apps — SmartOWON for device control and energy monitoring, and the X5 Config Tool for Zigbee device debugging. Direct Android APK and iOS App Store links.',
  }}
>
  <section class="py-8 lg:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-4 text-sm text-muted dark:text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-default dark:text-slate-200">App Downloads</span>
      </nav>

      <!-- Dimension Tabs -->
      <div class="flex gap-1 p-1 bg-gray-100 dark:bg-slate-800 rounded-xl mb-8 w-fit">
        <a
          href="/resources/documentation"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-gray-600 dark:text-slate-400 hover:bg-white/60 dark:hover:bg-slate-700/60"
        >
          Documentation</a
        >
        <a
          href="/resources/videos"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-gray-600 dark:text-slate-400 hover:bg-white/60 dark:hover:bg-slate-700/60"
        >
          Videos</a
        >
        <a
          href="/resources/app"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 bg-white dark:bg-slate-700 text-default dark:text-slate-200 shadow-sm"
        >
          App Downloads</a
        >
        <a
          href="/resources/faq"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-gray-600 dark:text-slate-400 hover:bg-white/60 dark:hover:bg-slate-700/60"
          >FAQ</a
        >
      </div>

      <!-- Page heading -->
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-default dark:text-slate-100">App Downloads</h1>
        <p class="text-muted dark:text-slate-400 mt-2 max-w-2xl">
          OWON companion apps for device control, energy monitoring, and Zigbee debugging — iOS via the App Store,
          Android via direct APK download.
        </p>
      </div>

      <!-- SmartOWON -->
      <section class="mb-12">
        <div class="flex items-center gap-3 mb-2">
          <h2 class="text-xl font-bold text-default dark:text-slate-200">SmartOWON</h2>
          <span
            class="text-xs font-semibold px-2 py-0.5 rounded-full bg-blue-50 text-blue-600 dark:bg-blue-900/40 dark:text-blue-300"
            >v5.2.6</span
          >
        </div>
        <p class="text-sm text-muted dark:text-slate-400 mb-6">
          The OWON mobile app — pair and control OWON thermostats, plugs, sensors and meters, and monitor your energy
          data on the go.
        </p>
        <div class="grid gap-4 sm:grid-cols-2">
          <div
            class="p-5 rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 flex items-center gap-4"
          >
            <Icon name="tabler:brand-apple" class="w-8 h-8" />
            <div>
              <h3 class="font-semibold text-default dark:text-slate-200 text-sm">SmartOWON — iOS</h3>
              <p class="text-xs text-muted dark:text-slate-400 mb-3">Download from the App Store</p>
              <a
                href="https://apps.apple.com/cn/app/smartowon/id1306572782"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1 text-xs font-semibold text-white bg-neutral-900 hover:bg-neutral-700 px-3 py-1.5 rounded-lg transition-colors"
              >
                <Icon name="tabler:external-link" class="w-3.5 h-3.5" /> App Store</a
              >
            </div>
          </div>
          <div
            class="p-5 rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 flex items-center gap-4"
          >
            <Icon name="tabler:robot" class="w-8 h-8" />
            <div>
              <h3 class="font-semibold text-default dark:text-slate-200 text-sm">SmartOWON — Android</h3>
              <p class="text-xs text-muted dark:text-slate-400 mb-3">Direct APK · 65 MB · v5.2.6 (build 2024-10-28)</p>
              <a
                href="https://documents.owon-iot.com/apps/SmartOWON.apk"
                class="inline-flex items-center gap-1 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-500 px-3 py-1.5 rounded-lg transition-colors"
              >
                <Icon name="tabler:download" class="w-3.5 h-3.5" /> Download APK</a
              >
            </div>
          </div>
        </div>
      </section>

      <!-- X5 Config Tool -->
      <section class="mb-12">
        <div class="flex items-center gap-3 mb-2">
          <h2 class="text-xl font-bold text-default dark:text-slate-200">X5 Config Tool</h2>
          <span
            class="text-xs font-semibold px-2 py-0.5 rounded-full bg-blue-50 text-blue-600 dark:bg-blue-900/40 dark:text-blue-300"
            >v5.3.3</span
          >
        </div>
        <p class="text-sm text-muted dark:text-slate-400 mb-6">
          The OWON Zigbee debugging tool — pair and configure Zigbee devices through the X5 gateway, inspect clusters
          and attributes, and debug MQTT integration. Built for developers integrating OWON devices.
        </p>
        <div class="grid gap-4 sm:grid-cols-2">
          <div
            class="p-5 rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 flex items-center gap-4"
          >
            <Icon name="tabler:brand-apple" class="w-8 h-8" />
            <div>
              <h3 class="font-semibold text-default dark:text-slate-200 text-sm">X5 Config Tool — iOS</h3>
              <p class="text-xs text-muted dark:text-slate-400 mb-3">Download from the App Store</p>
              <a
                href="https://apps.apple.com/cn/app/x5-config-tool/id1595999687"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1 text-xs font-semibold text-white bg-neutral-900 hover:bg-neutral-700 px-3 py-1.5 rounded-lg transition-colors"
              >
                <Icon name="tabler:external-link" class="w-3.5 h-3.5" /> App Store</a
              >
            </div>
          </div>
          <div
            class="p-5 rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 flex items-center gap-4"
          >
            <Icon name="tabler:robot" class="w-8 h-8" />
            <div>
              <h3 class="font-semibold text-default dark:text-slate-200 text-sm">X5 Config Tool — Android</h3>
              <p class="text-xs text-muted dark:text-slate-400 mb-3">Direct APK · 49 MB · v5.3.3 (2026-05)</p>
              <a
                href="https://documents.owon-iot.com/apps/OWON-MQTT-Config-Tool.apk"
                class="inline-flex items-center gap-1 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-500 px-3 py-1.5 rounded-lg transition-colors"
              >
                <Icon name="tabler:download" class="w-3.5 h-3.5" /> Download APK</a
              >
            </div>
          </div>
        </div>
      </section>

      <!-- Install note -->
      <div class="rounded-xl border border-amber-200 bg-amber-50 dark:border-amber-800/50 dark:bg-amber-900/20 p-4">
        <p class="text-xs text-amber-800 dark:text-amber-200">
          <strong>Android APK notes:</strong> Our APKs are distributed directly from OWON's official server. On first install,
          allow "Install unknown apps" for your browser if prompted. For production integration, always test against the latest
          firmware — contact us if you need a specific app version.
        </p>
      </div>
    </div>
  </section>
</PageLayout>
