---
import PageLayout from '~/layouts/PageLayout.astro';
import ContactBand from '~/components/common/ContactBand.astro';
import { productDocs } from '~/data/documents';

// Static page: build-time render → Cloudflare CDN caches the 449KB HTML,
// eliminating per-request SSR re-render (TTFB 1.5s → ~50ms).
export const prerender = true;

// Group by category for the filter
const categories = ['All', ...Array.from(new Set(productDocs.map((d) => d.category)))];
const totalCount = productDocs.reduce((sum, d) => sum + d.specs.length + d.manuals.length, 0);
---

<PageLayout
  metadata={{
    title: 'Documentation',
    description:
      'Download product datasheets, user manuals, and quick start guides for all OWON smart meters, thermostats, sensors, gateways, and IoT devices.',
  }}
>
  {
    /* SVG sprite: define icons once, reference via <use> — saves ~140KB of
       duplicated inline SVG across 545 icon instances */
  }
  <svg width="0" height="0" class="absolute" aria-hidden="true">
    <defs>
      <symbol id="icon-doc" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
        ></path>
      </symbol>
      <symbol id="icon-manual" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
        ></path>
      </symbol>
      <symbol id="icon-download" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
        ></path>
      </symbol>
    </defs>
  </svg>

  <section class="py-8 lg:py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {/* Breadcrumb */}
      <nav class="mb-4 text-sm text-muted dark:text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span class="mx-2">/</span>
        <span class="text-default dark:text-slate-200">Documentation</span>
      </nav>

      {/* Dimension Tabs */}
      <div class="flex gap-1 p-1 bg-gray-100 dark:bg-slate-800 rounded-xl mb-6 w-fit">
        <a
          href="/resources/documentation"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 bg-white dark:bg-slate-700 text-default dark:text-slate-200 shadow-sm"
          >📄 Documentation</a
        >
        <a
          href="/resources/videos"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-gray-600 dark:text-slate-400 hover:bg-white/60 dark:hover:bg-slate-700/60"
          >🎬 Videos</a
        >
        <a
          href="/resources/app"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-gray-600 dark:text-slate-400 hover:bg-white/60 dark:hover:bg-slate-700/60"
          >📱 App Downloads</a
        >
        <a
          href="/resources/faq"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-gray-600 dark:text-slate-400 hover:bg-white/60 dark:hover:bg-slate-700/60"
          >FAQ</a
        >
      </div>

      {/* Filter Card */}
      <div
        class="bg-white dark:bg-slate-800/50 rounded-xl p-4 mb-6 border border-gray-200 dark:border-slate-700 shadow-sm"
      >
        {/* Search */}
        <div class="mb-4">
          <div class="relative max-w-md">
            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg
              >
            </span>
            <input
              type="text"
              id="brochureSearch"
              placeholder="Search by model number or name (e.g. PC341, PCT513, SEG-X5)..."
              class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-default dark:text-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-shadow"
            />
          </div>
        </div>

        {/* Category Filters */}
        <div class="flex items-center gap-2 flex-wrap" id="brochureFilters">
          <span class="text-xs font-semibold text-gray-700 dark:text-slate-300 uppercase tracking-wider shrink-0"
            >Category:</span
          >
          {
            categories.map((cat, i) => (
              <button
                class={`filter-chip px-4 py-2 rounded-full text-sm font-semibold cursor-pointer transition-all duration-150 ${
                  i === 0
                    ? 'bg-primary text-primary-foreground border border-primary shadow-sm'
                    : 'text-gray-600 dark:text-slate-400 bg-white dark:bg-slate-800 border-2 border-gray-300 dark:border-slate-600 hover:border-primary dark:hover:border-primary hover:text-primary'
                }`}
                data-category={cat}
              >
                {cat}
              </button>
            ))
          }
        </div>
      </div>

      {/* Count */}
      <span class="text-sm text-muted dark:text-slate-400 mb-4 block">
        Showing <strong id="brochureCount" class="text-default dark:text-slate-200 font-semibold"
          >{productDocs.length}</strong
        > product models · {totalCount} documents
      </span>

      {/* Product Documentation Grid */}
      <div id="brochureList" class="space-y-6">
        {
          productDocs.map((doc) => (
            <div
              class="brochure-item bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 p-5"
              data-category={doc.category}
            >
              <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                <div>
                  <h2 class="text-lg font-bold text-default dark:text-slate-100">
                    <span class="text-primary font-mono mr-2">{doc.model}</span>
                  </h2>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-primary/10 text-primary mt-1">
                    {doc.category}
                  </span>
                </div>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                {/* Datasheets */}
                <div>
                  <h3 class="text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5">
                      <use href="#icon-doc" />
                    </svg>
                    Datasheet ({doc.specs.length})
                  </h3>
                  {doc.specs.length > 0 ? (
                    <ul class="space-y-1.5">
                      {doc.specs.map((s) => (
                        <li>
                          <a
                            href={s.url}
                            target="_blank"
                            rel="noopener"
                            class="inline-flex items-center gap-1.5 text-sm text-muted dark:text-slate-400 hover:text-primary transition-colors group"
                          >
                            <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-primary flex-shrink-0">
                              <use href="#icon-download" />
                            </svg>
                            {s.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="text-xs text-muted dark:text-slate-500 italic">Coming soon</p>
                  )}
                </div>

                {/* Manuals */}
                <div>
                  <h3 class="text-xs font-semibold text-gray-500 dark:text-slate-400 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5">
                      <use href="#icon-manual" />
                    </svg>
                    Manual ({doc.manuals.length})
                  </h3>
                  {doc.manuals.length > 0 ? (
                    <ul class="space-y-1.5">
                      {doc.manuals.map((s) => (
                        <li>
                          <a
                            href={s.url}
                            target="_blank"
                            rel="noopener"
                            class="inline-flex items-center gap-1.5 text-sm text-muted dark:text-slate-400 hover:text-primary transition-colors group"
                          >
                            <svg class="w-3.5 h-3.5 text-gray-400 group-hover:text-primary flex-shrink-0">
                              <use href="#icon-download" />
                            </svg>
                            {s.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="text-xs text-muted dark:text-slate-500 italic">Coming soon</p>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>

      {/* No Results */}
      <div id="noResults" class="hidden text-center py-16">
        <div class="text-4xl mb-4">🔍</div>
        <h3 class="text-lg font-semibold text-default dark:text-slate-200 mb-2">No documents found</h3>
        <p class="text-sm text-muted dark:text-slate-400 mb-4">Try a different model number or keyword.</p>
      </div>

      {/* CTA */}
      <ContactBand />
    </div>
  </section>
</PageLayout>

<script is:inline>
  (function () {
    const search = document.getElementById('brochureSearch');
    const filters = document.getElementById('brochureFilters');
    const items = document.querySelectorAll('.brochure-item');
    const countEl = document.getElementById('brochureCount');
    const noResults = document.getElementById('noResults');
    let currentCategory = 'All';

    function applyFilter() {
      const term = search ? search.value.toLowerCase().trim() : '';
      let visible = 0;

      items.forEach(function (item) {
        const text = item.textContent.toLowerCase();
        const catMatch = currentCategory === 'All' || item.getAttribute('data-category') === currentCategory;
        const termMatch = !term || text.indexOf(term) !== -1;
        if (catMatch && termMatch) {
          item.style.display = '';
          visible++;
        } else {
          item.style.display = 'none';
        }
      });

      if (countEl) countEl.textContent = visible;
      if (noResults) noResults.style.display = visible > 0 ? 'none' : '';
    }

    if (filters) {
      filters.querySelectorAll('.filter-chip').forEach(function (chip) {
        chip.addEventListener('click', function () {
          filters.querySelectorAll('.filter-chip').forEach(function (c) {
            c.className = c.className.replace(
              /bg-primary text-primary-foreground border border-primary shadow-sm/g,
              'text-gray-600 dark:text-slate-400 bg-white dark:bg-slate-800 border-2 border-gray-300 dark:border-slate-600 hover:border-primary dark:hover:border-primary hover:text-primary'
            );
          });
          this.className =
            'filter-chip px-4 py-2 rounded-full text-sm font-semibold cursor-pointer transition-all duration-150 bg-primary text-primary-foreground border border-primary shadow-sm';
          currentCategory = this.getAttribute('data-category');
          applyFilter();
        });
      });
    }

    if (search) {
      let searchTimer;
      search.addEventListener('input', function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(applyFilter, 300);
      });
    }
  })();
</script>
