---
// Static page: build-time render → CDN-cached (homepage is 84KB HTML).
export const prerender = true;

import Layout from '~/layouts/PageLayout.astro';
import ContactBand from '~/components/common/ContactBand.astro';

import { getPermalink } from '~/utils/permalinks';
import { getCollection } from 'astro:content';

const metadata = {
  title: 'Smart IoT Devices for Your Industry — OWON',
  ignoreTitleTemplate: true,
};

const productsUrl = getPermalink('/products');
const contactUrl = getPermalink('/contact');
const developersUrl = getPermalink('/developers');
const solutionsUrl = getPermalink('/solutions');

// Technology cards: product counts are computed from real catalog data at build time,
// so adding products later updates the homepage automatically (no manual edits).
import { products as rawProductEntries } from '~/data/products';
const protocolCount = (filter: (d: Record<string, unknown>) => boolean): number =>
  rawProductEntries.filter((e) => filter((e.data || {}) as Record<string, unknown>)).length;
const protoComm = (v: string) => protocolCount((d) => ((d.communication as string[]) || []).includes(v));
const protoSol = (v: string) => protocolCount((d) => d.techSolution === v);
// Official protocol icons: brand marks from Simple Icons / custom-brand-icons,
// generic protocol icons from Lucide. Rendered white on gradient chip.
// Official protocol icons: brand marks (fill) from Simple Icons / custom-brand-icons,
// generic protocol icons (stroke) from Lucide. Rendered white on gradient chip.
const iconPaths: Record<string, string[]> = {
  tcpip: [
    'M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.319-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831 2.34 2.34 0 0 1 2.33-4.033 2.34 2.34 0 0 0 3.319-1.915M12 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4',
  ],
  modbus: [
    'M10 16h.01',
    'M2.212 11.577a2 2 0 0 0-.212.896V18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5.527a2 2 0 0 0-.212-.896',
    'M21.946 12.013H2.054',
    'M6 16h.01',
  ],
  wifi: ['M12 20h.01', 'M2 8.82a15 15 0 0 1 20 0', 'M5 12.859a10 10 0 0 1 14 0', 'M8.5 16.429a5 5 0 0 1 7 0'],
  '4g': ['M2 20h.01', 'M7 20v-4', 'M12 20v-8', 'M17 20V8', 'M22 4v16'],
  rj45: [
    'M10 8v1',
    'M14 8v1',
    'M18 8v1',
    'M19 17a2 2 0 00-1.765 1.059l-.47.882A2 2 0 0115 20H9a2 2 0 01-1.765-1.059l-.47-.882A2 2 0 005 17H4a2 2 0 01-2-2V6a2 2 0 012-2h16a2 2 0 012 2v9a2 2 0 01-2 2z',
    'M6 8v1',
  ],
  rf: [
    'M16.247 7.761a6 6 0 0 1 0 8.478',
    'M19.075 4.933a10 10 0 0 1 0 14.134',
    'M4.925 19.067a10 10 0 0 1 0-14.134',
    'M7.753 16.239a6 6 0 0 1 0-8.478',
  ],
  rs485: ['M4.7 19.3 19 5', 'm21 3-3 1 2 2Z', 'M9.26 7.68 5 12l2 5', 'm10 14 5 2 3.5-3.5', 'm18 12 1-1 1 1-1 1Z'],
  zigbee: [
    'M11.988 0a11.85 11.85 0 00-8.617 3.696c7.02-.875 11.401-.583 13.289-.34 3.752.583 3.558 3.404 3.558 3.404L8.237 19.112c2.299.22 6.897.366 13.796-.631a11.86 11.86 0 001.912-6.469C23.945 5.374 18.595 0 11.988 0zm.232 4.31c-2.451-.014-5.772.146-9.963.723C.854 7.003.055 9.41.055 12.012.055 18.626 5.38 24 11.988 24c3.63 0 6.85-1.63 9.053-4.182-7.286.948-11.813.631-13.75.388-3.775-.56-3.557-3.404-3.557-3.404L15.691 4.474a38.635 38.635 0 00-3.471-.163Z',
  ],
  bluetooth: [
    'M12 0C6.76 0 3.1484 2.4895 3.1484 12S6.76 24 12 24c5.24 0 8.8516-2.4895 8.8516-12S17.24 0 12 0zm-.7773 1.6816l6.2148 6.2149L13.334 12l4.1035 4.1035-6.2148 6.2149V14.125l-3.418 3.42-1.2422-1.2442L10.8515 12l-4.289-4.3008 1.2422-1.2441 3.418 3.4199V1.6816zm1.748 4.2442v3.9687l1.9844-1.9843-1.9844-1.9844zm0 8.1816v3.9668l1.9844-1.9844-1.9844-1.9824Z',
  ],
  mqtt: [
    'M10.657 23.994h-9.45A1.212 1.212 0 0 1 0 22.788v-9.18h.071c5.784 0 10.504 4.65 10.586 10.386Zm7.606 0h-4.045C14.135 16.246 7.795 9.977 0 9.942V6.038h.071c9.983 0 18.121 8.044 18.192 17.956Zm4.53 0h-.97C21.754 12.071 11.995 2.407 0 2.372v-1.16C0 .55.544.006 1.207.006h7.64C15.733 2.49 21.257 7.789 24 14.508v8.291c0 .663-.544 1.195-1.207 1.195ZM16.713.006h6.092A1.19 1.19 0 0 1 24 1.2v5.914c-.91-1.242-2.046-2.65-3.158-3.762C19.588 2.11 18.122.987 16.714.005Z',
  ],
  tuya: [
    'M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2m2.611 14.365a1.7 1.7 0 0 1-.626.059a6.7 6.7 0 0 1-1.187-.051a3.17 3.17 0 0 1-2.003-1.241a3.3 3.3 0 0 1-.632-2.05c.02-.603.045-1.206.066-1.808h-.887a.81.81 0 0 1-.766-.72a.884.884 0 0 1 .813-.964h.897c.014-.384.022-.768.041-1.151a.884.884 0 0 1 .941-.795a.813.813 0 0 1 .749.803c-.008.382-.025.764-.037 1.147h2.4a.81.81 0 0 1 .782.721a.884.884 0 0 1-.835.97h-2.41l-.067 1.758a1.65 1.65 0 0 0 .429 1.205a1.56 1.56 0 0 0 1.105.494c.342.006.685 0 1.027 0a.81.81 0 0 1 .746.717a.88.88 0 0 1-.546.906m1.479-6.427a.33.33 0 0 1-.274-.059a.34.34 0 0 1-.144-.22a.8.8 0 0 0-.081-.502a.63.63 0 0 0-.542-.321h-.036a.7.7 0 0 0-.233.052a.4.4 0 0 1-.217.034a.33.33 0 0 1-.248-.181a.33.33 0 0 1-.014-.301c.077-.183.301-.241.526-.284a1.34 1.34 0 0 1 1.082.309a1.36 1.36 0 0 1 .455 1.174a.35.35 0 0 1-.277.298Zm1.847-.324a.345.345 0 0 1-.414.277a.35.35 0 0 1-.277-.383a2.11 2.11 0 0 0-2.093-2.382a2 2 0 0 0-.589.086a2 2 0 0 0-.201.073a.45.45 0 0 1-.375.051a.35.35 0 0 1-.089-.597a2.5 2.5 0 0 1 .883-.282a2.802 2.802 0 0 1 3.152 3.158Z',
  ],
};
// Icons rendered as filled brand marks (vs stroked Lucide glyphs)
const filledIcons = new Set(['zigbee', 'bluetooth', 'mqtt', 'tuya']);
const techGroups = [
  {
    label: 'Intelligence',
    hint: 'Protocol stacks, cloud platform integration, and data interaction capabilities.',
    cards: [
      {
        name: 'Tuya',
        desc: 'Certified devices • Smart Life app • Global cloud • Consumer-friendly',
        icon: 'tuya',
        iconSize: 'w-8.5 h-8.5',
        href: '/products?dim=solution&sol=tuya',
        count: protoSol('tuya'),
        color: 'from-sky-500 to-blue-600',
      },
      {
        name: 'MQTT/HTTP',
        desc: 'Real-time streaming • REST APIs • TLS security • SCADA/BMS integration • JSON payloads',
        icon: 'mqtt',
        href: '/products?dim=solution&sol=mqtt',
        count: protoSol('mqtt'),
        color: 'from-amber-500 to-orange-600',
      },
      {
        name: 'TCP/IP',
        desc: 'Ethernet networking • Direct IP addressing • Web APIs',
        icon: 'tcpip',
        href: '/products?dim=comm&comm=tcpip',
        count: protoComm('tcpip'),
        color: 'from-cyan-500 to-teal-600',
      },
      {
        name: 'Modbus',
        desc: 'Industrial RS-485 • Legacy system compatible • Reliable polling',
        icon: 'modbus',
        href: '/products?dim=comm&comm=rs485',
        count: protoComm('rs485'),
        color: 'from-violet-500 to-purple-600',
      },
    ],
  },
  {
    label: 'Connection',
    hint: 'Wireless and wired access methods, plus networking and mesh topologies.',
    cards: [
      {
        name: 'ZigBee',
        desc: 'Self-healing mesh • 100m+ range • Low power • 250+ devices per gateway',
        icon: 'zigbee',
        href: '/products?dim=comm&comm=zigbee',
        count: protoComm('zigbee'),
        color: 'from-emerald-500 to-teal-500',
      },
      {
        name: 'WiFi',
        desc: '2.4GHz 802.11 b/g/n • App & cloud control',
        icon: 'wifi',
        href: '/products?dim=comm&comm=wifi',
        count: protoComm('wifi'),
        color: 'from-blue-500 to-indigo-600',
      },
      {
        name: 'Bluetooth',
        desc: 'BLE pairing & quick configuration',
        icon: 'bluetooth',
        href: '/products?dim=comm&comm=ble',
        count: protoComm('ble'),
        color: 'from-indigo-500 to-blue-700',
      },
      {
        name: '4G',
        desc: 'Cellular connectivity for remote sites',
        icon: '4g',
        href: '/products?dim=comm&comm=4g',
        count: protoComm('4g'),
        color: 'from-rose-500 to-red-600',
      },
      {
        name: 'RJ45',
        desc: 'Wired Ethernet for stable industrial links',
        icon: 'rj45',
        href: '/products?dim=comm&comm=rj45',
        count: protoComm('rj45'),
        color: 'from-amber-500 to-yellow-600',
      },
      {
        name: 'RF',
        desc: 'Radio frequency remote control',
        icon: 'rf',
        href: '/products?dim=comm&comm=rf',
        count: protoComm('rf'),
        color: 'from-pink-500 to-rose-600',
      },
      {
        name: 'RS-485',
        desc: 'Industrial bus • Modbus RTU compatible',
        icon: 'rs485',
        href: '/products?dim=comm&comm=rs485',
        count: protoComm('rs485'),
        color: 'from-slate-500 to-gray-700',
      },
    ],
  },
];

// Real solution pages drive the homepage carousel (title/subtitle/image/slug from mdoc data)
import { solutions as rawSolutions } from '~/data/solutions';
const solutionSlideMap: Record<string, { color: string; features: string[] }> = {
  'smart-hotels': {
    color: 'from-blue-600 to-sky-500',
    features: ['Per-room energy monitoring', 'Occupancy-based HVAC control', 'Central dashboard for facility managers'],
  },
  'senior-care': {
    color: 'from-rose-600 to-pink-500',
    features: ['Non-contact sleep monitoring', 'Emergency call system', 'AiJuan caregiver dashboard'],
  },
  'industrial-iot': {
    color: 'from-emerald-600 to-teal-500',
    features: ['Per-machine energy tracking', 'MQTT to SCADA / BMS', 'EdgeEco analytics'],
  },
};
// Extract first real body paragraph (after the first ## heading) as the slide description
function firstBodyPara(body: string): string {
  const lines = body
    .split('\n')
    .map((l) => l.trim())
    .filter(Boolean);
  const start = lines.findIndex((l) => l.startsWith('## '));
  const para = start >= 0 ? lines.slice(start + 1).find((l) => !l.startsWith('#')) : undefined;
  return para || '';
}
const solutionSlides = rawSolutions.map((s) => {
  const d = s.data as Record<string, string | string[] | undefined>;
  const industry = (d.industry as string) || '';
  const style = solutionSlideMap[industry] || { color: 'from-blue-600 to-sky-500', features: [] };
  return {
    icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
    title: d.title as string,
    subtitle: d.subtitle as string,
    desc: firstBodyPara(s.body),
    features: style.features,
    img: (d.heroImage as string) || '',
    href: `/solutions/${s.slug}`,
    color: style.color,
  };
});

const heroSlides = [
  {
    title: 'Smart Energy Meters',
    subtitle: 'Tuya & MQTT — Precision metering for residential and commercial energy management',
    gradient: 'from-blue-700 via-blue-600 to-indigo-700',
    badges: ['Tuya', 'MQTT'],
    link: '/products?dim=type&type=smart-meters',
    linkText: 'Explore Smart Meters',
    imgSrc: '/images/hero/smart-energy-hero.webp',
  },
  {
    title: 'Smart Thermostats',
    subtitle: 'Tuya & MQTT — Touchscreen HVAC control for North American and European markets',
    gradient: 'from-orange-600 via-red-500 to-rose-600',
    badges: ['Tuya', 'MQTT'],
    link: '/products?dim=type&type=thermostats',
    linkText: 'Explore Thermostats',
    imgSrc: '/images/hero/thermostat-family-hero.webp',
  },
  {
    title: 'ZigBee Hotel Solution',
    subtitle: 'Air-conditioning comfort & energy savings — the ZigBee smart guest room solution',
    gradient: 'from-purple-700 via-violet-600 to-indigo-700',
    badges: ['ZigBee'],
    link: '/products?dim=type&type=hotel-control',
    linkText: 'Explore Hotel Solutions',
    imgSrc: '/images/hero/hotel-solution-hero.webp',
  },
  {
    title: 'ZigBee Senior Care',
    subtitle: 'Non-contact sleep monitoring, emergency call & health tracking for elderly facilities',
    gradient: 'from-teal-700 via-emerald-600 to-green-700',
    badges: ['ZigBee'],
    link: '/products?dim=type&type=senior-care',
    linkText: 'Explore Senior Care',
    imgSrc: '/images/hero/senior-care-hero.webp',
  },
];

const blogPosts = await getCollection('post');
const latestPosts = blogPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => {
    const dateA = a.data.publishDate ? new Date(a.data.publishDate).getTime() : 0;
    const dateB = b.data.publishDate ? new Date(b.data.publishDate).getTime() : 0;
    return dateB - dateA;
  })
  .slice(0, 3);
const formatDate = (date) => {
  if (!date) return '';
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
};
---

<Layout metadata={metadata}>
  <!-- ===== 1. Hero Carousel ===== -->
  <section class="hero-carousel relative w-full overflow-hidden md:min-h-[680px] lg:min-h-[760px]" id="heroSection">
    {/* Single visible-for-SEO H1 — rotating slide titles are H2s (4×H1 was invalid) */}
    <h1 class="sr-only">{heroSlides[0]?.title}</h1>
    {
      heroSlides.map((slide, i) => (
        <div
          class={`hero-slide flex items-start md:items-center transition-opacity duration-700 bg-gradient-to-r ${slide.gradient} md:absolute md:inset-0 ${i === 0 ? '' : 'hidden md:block'}`}
          class:list={[i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0']}
          data-index={i}
        >
          <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 w-full py-14 md:py-24">
            <div class="grid md:grid-cols-2 gap-8 md:gap-10 lg:gap-14 items-center">
              <div class="text-center lg:text-left">
                <div class="flex gap-2 justify-center lg:justify-start mb-4">
                  {slide.badges.map((b) => (
                    <span class="inline-flex items-center rounded-full bg-white/20 backdrop-blur-sm px-3 py-1 text-sm font-semibold text-white border border-white/30">
                      {b}
                    </span>
                  ))}
                </div>
                <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-4">{slide.title}</h2>
                <p class="text-lg md:text-xl text-white/80 mb-8 max-w-xl lg:mx-0">{slide.subtitle}</p>
                <div class="flex flex-wrap gap-3 justify-center lg:justify-start">
                  <a
                    href={slide.link}
                    class="inline-flex items-center gap-2 rounded-full bg-white text-gray-900 hover:bg-gray-100 font-semibold px-8 py-3.5 transition-colors shadow-lg"
                  >
                    {slide.linkText} &rarr;
                  </a>
                  <a
                    href={contactUrl}
                    class="inline-flex items-center gap-2 rounded-full bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-3.5 transition-colors border border-white/30 backdrop-blur-sm"
                  >
                    Contact Us
                  </a>
                </div>
              </div>
              <div class="flex items-center justify-center">
                <img
                  src={slide.imgSrc}
                  alt={
                    i === 0
                      ? 'OWON PC321 three-phase power clamp and PC341 multi-circuit smart energy meter'
                      : slide.title
                  }
                  class="w-full h-auto object-contain lg:w-auto lg:max-h-[560px] lg:block lg:mx-auto"
                  loading="eager"
                />
              </div>
            </div>
          </div>
        </div>
      ))
    }
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-20 flex gap-2.5">
      {
        heroSlides.map((_, i) => (
          <button
            class={`hero-dot w-3 h-3 rounded-full transition-all duration-300 border-2 border-white/60 ${i === 0 ? 'bg-white border-white scale-125' : 'bg-transparent hover:bg-white/40'}`}
            data-dot={i}
            aria-label={`Slide ${i + 1}`}
          />
        ))
      }
    </div>
  </section>

  <!-- ===== 3.5 Technology / Protocols ===== -->
  <section class="py-16 lg:py-20 bg-white dark:bg-slate-900" id="technologySection">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-3 text-default dark:text-slate-100">Technology</h2>
      <p class="text-center text-muted dark:text-slate-400 mb-10">Protocols &amp; ecosystems we support</p>
      {
        techGroups.map((group) => (
          <div class="mb-8 last:mb-0">
            <div class="flex items-center gap-2 mb-4">
              <span class="text-xs font-bold text-gray-700 dark:text-slate-300 uppercase tracking-wider">
                {group.label}
              </span>
              <span class="text-xs text-gray-400 cursor-help" title={group.hint}>
                ⓘ
              </span>
              <span class="flex-1 h-px bg-gray-200 dark:bg-slate-700" />
            </div>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {group.cards.map((proto) => (
                <a
                  href={proto.href}
                  class="group flex items-start gap-3.5 rounded-xl bg-gray-50 dark:bg-slate-800 border border-gray-100 dark:border-slate-700 p-4 hover:shadow-md hover:-translate-y-0.5 hover:border-primary/40 transition-all duration-300"
                >
                  <div
                    class={`w-11 h-11 shrink-0 rounded-lg bg-gradient-to-br ${proto.color} flex items-center justify-center shadow-md`}
                  >
                    {filledIcons.has(proto.icon) ? (
                      <svg
                        class={`${proto.iconSize || 'w-5.5 h-5.5'} text-white`}
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        stroke="none"
                      >
                        {(iconPaths[proto.icon] || []).map((d) => (
                          <path d={d} />
                        ))}
                      </svg>
                    ) : (
                      <svg
                        class={`${proto.iconSize || 'w-5.5 h-5.5'} text-white`}
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        {(iconPaths[proto.icon] || []).map((d) => (
                          <path d={d} />
                        ))}
                      </svg>
                    )}
                  </div>
                  <div class="min-w-0">
                    <h3 class="text-sm font-bold text-default dark:text-slate-200 leading-tight mb-0.5 group-hover:text-primary transition-colors">
                      {proto.name}
                    </h3>
                    <p class="text-xs text-muted dark:text-slate-400 leading-snug mb-1.5 line-clamp-2">{proto.desc}</p>
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-primary">
                      {proto.count} products
                      <svg
                        class="w-3 h-3 transition-transform group-hover:translate-x-0.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ===== 2. Product Categories ===== -->
  <section class="py-16 lg:py-20 bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-default dark:text-slate-100">
        Product Categories
      </h2>
      <div class="grid gap-5 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            {
              label: 'Smart Meters',
              desc: 'Single-phase, three-phase, multi-circuit DIN rail meters',
              img: '/images/hero/smart-energy-hero.webp',
              link: '/products?dim=type&type=smart-meters',
              badges: ['Tuya', 'MQTT', 'ZigBee'],
            },
            {
              label: 'Thermostats',
              desc: '24V AC, boiler, touchscreen & ZigBee HVAC controllers',
              img: '/images/hero/thermostat-family-hero.webp',
              link: '/products?dim=type&type=thermostats',
              badges: ['Tuya', 'MQTT', 'ZigBee'],
            },
            {
              label: 'Hotel Control',
              desc: 'Room thermostats, lighting, door signs & energy mgmt',
              img: '/images/hero/hotel-solution-hero.webp',
              link: '/products?dim=type&type=hotel-control',
              badges: ['ZigBee'],
            },
            {
              label: 'Senior Care',
              desc: 'Sleep monitors, emergency call, fall detection & nurse station',
              img: '/images/hero/senior-care-hero.webp',
              link: '/products?dim=type&type=senior-care',
              badges: ['ZigBee'],
            },
          ].map((cat) => (
            <a
              href={cat.link}
              class="group block rounded-2xl bg-white dark:bg-slate-800 border border-gray-100 dark:border-slate-700 overflow-hidden hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
            >
              <div class="aspect-square overflow-hidden bg-gray-50 dark:bg-slate-700">
                <img src={cat.img} alt={cat.label} class="w-full h-full object-cover" loading="lazy" />
              </div>
              <div class="p-4 sm:p-5">
                <h3 class="text-xl sm:text-2xl font-bold text-default dark:text-slate-200 mb-1">{cat.label}</h3>
                <p class="text-sm text-muted dark:text-slate-400 mb-3">{cat.desc}</p>
                <div class="flex gap-1.5 flex-wrap">
