<script>
  (function () {
    const section = document.getElementById('heroSection');
    if (!section) return;
    const slides = section.querySelectorAll('.hero-slide');
    const dots = section.querySelectorAll('.hero-dot');
    if (slides.length === 0) return;
    let current = 0,
      timer;
    function showSlide(i) {
      slides.forEach(function (s, j) {
        s.classList.toggle('opacity-100', j === i);
        s.classList.toggle('z-10', j === i);
        s.classList.toggle('opacity-0', j !== i);
        s.classList.toggle('z-0', j !== i);
        // Mobile (<md): only the active slide occupies layout; md+ all absolute anyway
        if (j === i) {
          s.classList.remove('hidden');
        } else {
          if (window.innerWidth < 768) s.classList.add('hidden');
        }
      });
      dots.forEach(function (d, j) {
        d.classList.toggle('bg-white', j === i);
        d.classList.toggle('border-white', j === i);
        d.classList.toggle('scale-125', j === i);
        d.classList.toggle('bg-transparent', j !== i);
      });
      current = i;
    }
    window.addEventListener('resize', function () {
      if (window.innerWidth >= 768) {
        slides.forEach(function (s) {
          s.classList.remove('hidden');
        });
        showSlide(current);
      } else {
        showSlide(current);
      }
    });
    function next() {
      showSlide((current + 1) % slides.length);
    }
    function start() {
      stop();
      timer = setInterval(next, 5000);
    }
    function stop() {
      if (timer) clearInterval(timer);
    }
    dots.forEach(function (d) {
      d.addEventListener('click', function () {
        showSlide(parseInt(d.getAttribute('data-dot'), 10));
        start();
      });
    });
    start();
  })();
  (function () {
    const track = document.getElementById('solTrack');
    const prev = document.getElementById('solPrev');
    const next = document.getElementById('solNext');
    const dots = document.querySelectorAll('.sol-dot');
    if (!track || !prev || !next) return;
    const slides = track.querySelectorAll('[data-sol-index]');
    const total = slides.length;
    let current = 0;
    function goTo(i) {
      if (i < 0) i = total - 1;
      if (i >= total) i = 0;
      current = i;
      track.style.transform = 'translateX(-' + i * 100 + '%)';
      dots.forEach(function (d, j) {
        d.classList.toggle('bg-primary', j === i);
        d.classList.toggle('scale-125', j === i);
        d.classList.toggle('bg-gray-300', j !== i);
        d.classList.toggle('dark:bg-slate-600', j !== i);
      });
    }
    prev.addEventListener('click', function () {
      goTo(current - 1);
    });
    next.addEventListener('click', function () {
      goTo(current + 1);
    });
    dots.forEach(function (d) {
      d.addEventListener('click', function () {
        goTo(parseInt(d.getAttribute('data-sol-dot'), 10));
      });
    });
  })();
  (function () {
    const video = document.getElementById('aboutVideo');
    if (!video) return;
    video.addEventListener('click', function () {
      const thumb = document.getElementById('videoThumb');
      const frame = document.getElementById('videoFrame');
      if (!thumb || !frame) return;
      thumb.style.display = 'none';
      frame.classList.remove('hidden');
    });
  })();
</script>
