---
import { Icon } from 'astro-icon/components';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light' } = Astro.props;

const brandTagline =
  'OWON Technology — professional smart energy solutions provider. Smart meters, thermostats, senior care devices, hotel control systems and IoT platforms for B2B customers worldwide.';
const contactEmail = 'info@owon-iot.com';
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative border-t border-gray-200 dark:border-slate-800 not-prose']}>
  <div class="dark:bg-dark absolute inset-0 pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-14 dark:text-slate-300">
    <div class="grid grid-cols-12 gap-x-8 gap-y-10">
      <div class="col-span-12 lg:col-span-4">
        <a class="inline-block" href={getHomePermalink()}>
          <img src="/images/logo.png" alt="OWON" class="h-9 w-auto dark:hidden" />
          <img src="/images/logo-white.png" alt="OWON" class="h-9 w-auto hidden dark:block" />
        </a>
        <p class="mt-4 text-sm leading-relaxed text-muted dark:text-gray-400 max-w-sm">{brandTagline}</p>
        <a
          href={`mailto:${contactEmail}`}
          class="mt-4 inline-flex items-center gap-2 text-sm text-muted hover:text-link dark:text-gray-400 dark:hover:text-white transition duration-150 ease-in-out"
        >
          <Icon name="tabler:mail" class="w-4 h-4" />
          {contactEmail}
        </a>
        {
          secondaryLinks?.length ? (
            <div class="mt-3 text-sm text-muted flex gap-1">
              {secondaryLinks.map(({ text, href }, index) => (
                <>
                  {index !== 0 ? ' · ' : ''}
                  <a
                    class="text-muted hover:text-link dark:text-gray-400 hover:underline transition duration-150 ease-in-out"
                    href={href}
                    set:html={text}
                  />
                </>
              ))}
            </div>
          ) : (
            ''
          )
        }
      </div>

      {
        links.map(({ title, links }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <div class="text-gray-900 dark:text-gray-200 font-semibold text-sm mb-3">{title}</div>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="text-sm space-y-2.5">
                {links.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a
                      class="text-muted hover:text-link dark:text-gray-400 dark:hover:text-white transition duration-150 ease-in-out"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>

    <div class="mt-10 md:mt-12 pt-6 border-t border-gray-200 dark:border-slate-800 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="text-sm text-muted dark:text-gray-400">
        <Fragment set:html={footNote} />
      </div>
      {
        socialLinks?.length ? (
          <ul class="flex -ml-2">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="text-muted dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-link dark:hover:text-white focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label={ariaLabel}
                  href={href}
                >
                  {icon && <Icon name={icon} class="w-5 h-5" />}
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          ''
        )
      }
    </div>
  </div>
</footer>
