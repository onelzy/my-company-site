---
import { twMerge } from 'tailwind-merge';
import Image from '~/components/common/Image.astro';
import type { Product } from '~/types';
import { SPEC_LABELS, getLocalizedLabel } from '~/utils/products';

export interface Props {
  product: Product;
  href: string;
  class?: string;
  /** Compact card: smaller image, hidden description, slim buttons — for Related Products row */
  compact?: boolean;
}

const { product, href, class: className, compact = false } = Astro.props;
const description = product.description?.trim() ?? '';
const commMethods = product.communication ?? [];
const visibleComms = commMethods.slice(0, 4);
const overflowCount = commMethods.length - visibleComms.length;
const detailUrl = href.replace(/\/$/, '') + '/' + product.slug;
const imageSrc = product.image || undefined;
const hasImage = !!imageSrc;
const modelDisplay = product.model?.trim() ?? '';
const locale = (product.language as string) || 'en';

// Build the onclick in JS scope so {product.name} is GUARANTEED interpolated
// (attribute-string interpolation of {expr} proved unreliable in this file).
const leadClick = `window.__openLeadModal ? window.__openLeadModal({ scenario: 'price', productName: ${JSON.stringify(product.name)} }) : (window.location.href = '/contact')`;
---

<div
  class="product-card-wrapper"
  data-product-type={product.productType || ''}
  data-product-subtype={product.productSubType || ''}
  data-tech-solution={product.techSolution || ''}
  data-tech-subtype={product.techSubType || ''}
  data-comm={JSON.stringify(product.communication || [])}
  data-eco={JSON.stringify(product.ecosystem || [])}
  data-tags={JSON.stringify(product.extraTags || [])}
  data-sw={JSON.stringify(product.softwareType || [])}
>
  <div
    class={twMerge(
      'group rounded-xl bg-white dark:bg-slate-800 shadow-md hover:shadow-xl',
      'border border-gray-200 dark:border-slate-700',
      'transition-all duration-300 ease-in-out',
      'flex flex-col overflow-hidden h-full',
      className
    )}
  >
    <!-- Product image (clickable link to detail) -->
    <!-- Square container matches the square product master images (1200x1200);
         fixed-height rectangles would crop/letterbox them -->
    <a
      href={detailUrl}
      class:list={[
        'relative aspect-square bg-gray-100 dark:bg-slate-700 overflow-hidden block focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2',
      ]}
    >
      {
        hasImage ? (
          <Image
            src={imageSrc}
            alt={product.name}
            layout="cover"
            class="absolute inset-0 w-full h-full"
            width={600}
            height={600}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="absolute inset-0 flex items-center justify-center text-muted dark:text-slate-500">
            <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
          </div>
        )
      }
    </a>

    <!-- Card content (clickable) — compact typography so the content area
         stays below ~half the square image height -->
    <a href={detailUrl} class:list={['flex-1 block', compact ? 'px-2.5 py-1.5' : 'px-3 py-2']}>
      <h3
        class:list={[
          'font-semibold leading-snug text-default dark:text-slate-200 group-hover:text-primary transition-colors duration-200',
          compact ? 'text-[13px] line-clamp-1' : 'text-[15px] line-clamp-1',
        ]}
      >
        {product.name}
      </h3>
      {
        modelDisplay && (
          <p class:list={['text-muted dark:text-slate-400 font-mono', compact ? 'text-[10px]' : 'text-[11px]']}>
            {modelDisplay}
          </p>
        )
      }
      {
        description && !compact && (
          <p class="text-[11px] text-muted dark:text-slate-400 line-clamp-1 leading-snug mt-0.5">{description}</p>
        )
      }
      {
        visibleComms.length > 0 && (
          <div class="flex flex-wrap items-center gap-1 mt-1">
            {visibleComms.map((method) => (
              <span
                class="inline-flex items-center px-1.5 py-px rounded-full text-[10px] font-medium
                         bg-primary/10 text-primary dark:bg-primary/20 dark:text-primary-foreground
                         border border-primary/20 dark:border-primary/30"
              >
                {getLocalizedLabel(SPEC_LABELS, method, locale)}
              </span>
            ))}
            {overflowCount > 0 && (
              <span
                class="inline-flex items-center px-1.5 py-px rounded-full text-[10px] font-medium
                          bg-gray-100 text-muted dark:bg-slate-700 dark:text-slate-400"
              >
                +{overflowCount}
              </span>
            )}
          </div>
        )
      }
      {
        commMethods.length === 0 && (
          <div class="mt-1.5">
            <span
              class="inline-flex items-center px-1.5 py-px rounded-full text-[10px] font-medium
                        bg-gray-100 text-muted dark:bg-slate-700 dark:text-slate-400"
            >
              See details
            </span>
          </div>
        )
      }
    </a>

    <!-- Action buttons — slim to keep total content height ≤ ~half image -->
    <div class:list={['flex gap-1.5', compact ? 'px-2.5 pb-2' : 'px-3 pb-2.5']}>
      <a
        href={detailUrl}
        class="flex-1 text-center px-2 py-1 rounded-lg text-[11px] font-medium
               border border-gray-300 dark:border-slate-600
               text-default dark:text-slate-300
               hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors"
      >
        View Details
      </a>
      <button
        type="button"
        onclick={leadClick}
        class="flex-1 px-2 py-1 rounded-lg text-[11px] font-medium transition-colors
                    bg-[#FF6B00] text-white hover:bg-[#E55D00]"
      >
        Get Base Price
      </button>
    </div>
  </div>
</div>
