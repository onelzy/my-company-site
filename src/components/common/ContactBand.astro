---
// ContactBand.astro — embedded, professional contact options block.
// No floating UI, no chat bubble: a restrained contact strip placed at the
// end of the content flow (Siemens/Schneider-style). Shows real contact
// values (number + email visible) + a response-time promise for trust.
import { SITE } from 'astrowind:config';

interface Props {
  /** Product/solution name to prefill in the WhatsApp message (optional). */
  productName?: string;
}

const { productName = '' } = Astro.props;

const whatsapp = (SITE as unknown as Record<string, Record<string, string>>).contact?.whatsapp || '8618650139895';
const email = (SITE as unknown as Record<string, Record<string, string>>).contact?.email || 'info@owon-iot.com';

// +86 186 5013 9895 formatting
const displayPhone = `+${whatsapp.slice(0, 2)} ${whatsapp.slice(2, 5)} ${whatsapp.slice(5)}`;

const waText = productName
  ? `Hi! I have a question about ${productName}.`
  : `Hi! I have a question about your products.`;
const waUrl = `https://wa.me/${whatsapp}?text=${encodeURIComponent(waText)}`;
---

<section class="py-14" aria-label="Contact options">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="rounded-2xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-6 py-10 sm:px-12 text-center shadow-sm"
    >
      <h2 class="text-2xl font-bold text-default dark:text-slate-100 mb-2">Still have questions?</h2>
      <p class="text-muted dark:text-slate-400 text-sm mb-8 max-w-xl mx-auto">
        Our engineers usually reply within one business day. Reach us however suits you best.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-3 sm:gap-4">
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg bg-[#25D366] text-white font-semibold text-sm hover:opacity-90 transition-opacity"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path>
          </svg>
          WhatsApp {displayPhone}
        </a>
        <a
          href={`mailto:${email}`}
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg border border-gray-300 dark:border-slate-600 text-default dark:text-slate-200 font-semibold text-sm hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
          {email}
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-lg border border-gray-300 dark:border-slate-600 text-default dark:text-slate-200 font-semibold text-sm hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
            ></path>
          </svg>
          Contact Form
        </a>
      </div>
    </div>
  </div>
</section>
